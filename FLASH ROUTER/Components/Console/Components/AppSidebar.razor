@namespace FLASH_ROUTER.Components.Console.Components

<aside class="app-sidebar @(IsCollapsed ? "is-collapsed" : "")" aria-label="Điều hướng chính">
    <!-- Brand / Logo Area -->
    <div class="sidebar-brand">
        <div class="brand-symbol" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="var(--accent-primary)"></polygon>
            </svg>
        </div>
        <span class="brand-title">FLASH ROUTER</span>
    </div>

    <!-- Main Navigation Items -->
    <nav class="sidebar-nav" role="navigation">
        <ul class="nav-list">
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == "overview" ? "is-active" : "")" @onclick='() => SelectTab("overview")'>
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span class="nav-label">Tổng quan</span>
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == "accounts" ? "is-active" : "")" @onclick='() => SelectTab("accounts")'>
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <span class="nav-label">Quản lý tài khoản</span>
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == "automation" ? "is-active" : "")" @onclick='() => SelectTab("automation")'>
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    <span class="nav-label">Tự động hóa</span>
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == "activity" ? "is-active" : "")" @onclick='() => SelectTab("activity")'>
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span class="nav-label">Lịch sử hoạt động</span>
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == "configuration" ? "is-active" : "")" @onclick='() => SelectTab("configuration")'>
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="21" x2="4" y2="14"></line>
                        <line x1="4" y1="10" x2="4" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12" y2="3"></line>
                        <line x1="20" y1="21" x2="20" y2="16"></line>
                        <line x1="20" y1="12" x2="20" y2="3"></line>
                        <line x1="1" y1="14" x2="7" y2="14"></line>
                        <line x1="9" y1="8" x2="15" y2="8"></line>
                        <line x1="17" y1="16" x2="23" y2="16"></line>
                    </svg>
                    <span class="nav-label">Cấu hình</span>
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == "members" ? "is-active" : "")" @onclick='() => SelectTab("members")'>
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <line x1="19" y1="8" x2="19" y2="14"></line>
                        <line x1="22" y1="11" x2="16" y2="11"></line>
                    </svg>
                    <span class="nav-label">Thành viên</span>
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == "reports" ? "is-active" : "")" @onclick='() => SelectTab("reports")'>
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    <span class="nav-label">Báo cáo</span>
                </button>
            </li>
        </ul>
    </nav>

    <!-- Bottom Secondary Navigation -->
    <div class="sidebar-footer">
        <ul class="nav-list">
            <li class="nav-item">
                <button type="button" class="nav-link has-indicator @(ActiveTab == "notifications" ? "is-active" : "")" @onclick='() => SelectTab("notifications")'>
                    <div class="nav-icon-container">
                        <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        @if (HasNotifications)
                        {
                            <span class="notification-badge-dot" aria-label="Có thông báo mới"></span>
                        }
                    </div>
                    <span class="nav-label">Thông báo</span>
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == "settings" ? "is-active" : "")" @onclick='() => SelectTab("settings")'>
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                    <span class="nav-label">Cài đặt</span>
                </button>
            </li>
        </ul>
    </div>
</aside>

@code {
    [Parameter] public string ActiveTab { get; set; } = "accounts";
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }
    [Parameter] public bool HasNotifications { get; set; } = true;
    [Parameter] public bool IsCollapsed { get; set; } = false;

    private async Task SelectTab(string tab)
    {
        ActiveTab = tab;
        await OnTabSelected.InvokeAsync(tab);
    }
}
