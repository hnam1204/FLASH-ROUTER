@namespace FLASH_ROUTER.Components.Console.Components

<div class="platform-logo-badge @GetPlatformClass() @CustomClass" style="width: @(Size)px; height: @(Size)px;" title="@GetPlatformTitle()">
    @if (IsChatGPT)
    {
        <!-- ChatGPT Spiral SVG -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="platform-svg">
            <path d="M12 2a10 10 0 0 1 10 10 10 10 0 0 1-10 10 10 10 0 0 1-10-10A10 10 0 0 1 12 2z" fill="#10A37F" stroke="none"></path>
            <path d="M15.5 8.5c-.7-.7-1.8-.9-2.7-.6l-1.3.4c-.4.1-.8 0-1.1-.3l-.8-.8c-.6-.6-1.6-.7-2.3-.2-.7.5-.9 1.5-.5 2.3l.5 1.1c.2.4.1.8-.1 1.1l-.9.9c-.6.6-.7 1.6-.2 2.3.5.7 1.5.9 2.3.5l1.1-.5c.4-.2.8-.1 1.1.1l.9.9c.6.6 1.6.7 2.3.2.7-.5.9-1.5.5-2.3l-.5-1.1c-.2-.4-.1-.8.1-1.1l.9-.9c.7-.6.8-1.6.2-2.3z" fill="white" stroke="none"></path>
            <circle cx="12" cy="12" r="2" fill="#10A37F"></circle>
        </svg>
    }
    else if (IsClaude)
    {
        <!-- Claude Star SVG -->
        <svg viewBox="0 0 24 24" fill="none" class="platform-svg">
            <rect width="24" height="24" rx="6" fill="#CC5636"></rect>
            <path d="M12 4.5l1.8 4.7 4.7 1.8-4.7 1.8-1.8 4.7-1.8-4.7-4.7-1.8 4.7-1.8 1.8-4.7z" fill="white"></path>
        </svg>
    }
    else if (IsGemini)
    {
        <!-- Gemini 4-Point Star SVG -->
        <svg viewBox="0 0 24 24" fill="none" class="platform-svg">
            <rect width="24" height="24" rx="6" fill="#1A2D54"></rect>
            <path d="M12 3C12 7.97 7.97 12 3 12C7.97 12 12 16.03 12 21C12 16.03 16.03 12 21 12C16.03 12 12 7.97 12 3Z" fill="url(#gemini-grad)"></path>
            <defs>
                <linearGradient id="gemini-grad" x1="3" y1="3" x2="21" y2="21" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#4E97FF"></stop>
                    <stop offset="0.5" stop-color="#809CFF"></stop>
                    <stop offset="1" stop-color="#C580FF"></stop>
                </linearGradient>
            </defs>
        </svg>
    }
    else if (IsPerplexity)
    {
        <!-- Perplexity Asterisk SVG -->
        <svg viewBox="0 0 24 24" fill="none" class="platform-svg">
            <rect width="24" height="24" rx="6" fill="#13171D"></rect>
            <path d="M12 5v14M5 12h14M7.05 7.05l9.9 9.9M7.05 16.95l9.9-9.9" stroke="#22B8CD" stroke-width="2.5" stroke-linecap="round"></path>
        </svg>
    }
    else if (IsHuflit)
    {
        <!-- HUFLIT Badge -->
        <div class="huflit-badge-inner">
            <span class="huflit-text">HU</span>
        </div>
    }
    else
    {
        <!-- Generic / AI Platform Fallback -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="platform-svg">
            <rect width="24" height="24" rx="6" fill="var(--app-elevated)"></rect>
            <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" fill="var(--accent-primary)" stroke="var(--accent-primary)"></path>
        </svg>
    }
</div>

@code {
    [Parameter] public string Provider { get; set; } = "";
    [Parameter] public int Size { get; set; } = 36;
    [Parameter] public string? CustomClass { get; set; }

    private bool IsChatGPT => Provider.Contains("chatgpt", StringComparison.OrdinalIgnoreCase) || Provider.Contains("openai", StringComparison.OrdinalIgnoreCase);
    private bool IsClaude => Provider.Contains("claude", StringComparison.OrdinalIgnoreCase) || Provider.Contains("anthropic", StringComparison.OrdinalIgnoreCase);
    private bool IsGemini => Provider.Contains("gemini", StringComparison.OrdinalIgnoreCase) || Provider.Contains("google", StringComparison.OrdinalIgnoreCase);
    private bool IsPerplexity => Provider.Contains("perplexity", StringComparison.OrdinalIgnoreCase);
    private bool IsHuflit => Provider.Contains("huflit", StringComparison.OrdinalIgnoreCase);

    private string GetPlatformClass()
    {
        if (IsChatGPT) return "platform-chatgpt";
        if (IsClaude) return "platform-claude";
        if (IsGemini) return "platform-gemini";
        if (IsPerplexity) return "platform-perplexity";
        if (IsHuflit) return "platform-huflit";
        return "platform-default";
    }

    private string GetPlatformTitle()
    {
        if (IsChatGPT) return "OpenAI ChatGPT";
        if (IsClaude) return "Anthropic Claude";
        if (IsGemini) return "Google Gemini";
        if (IsPerplexity) return "Perplexity AI";
        if (IsHuflit) return "HUFLIT Portal";
        return Provider;
    }
}
