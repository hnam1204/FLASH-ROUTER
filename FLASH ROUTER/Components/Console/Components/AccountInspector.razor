@namespace FLASH_ROUTER.Components.Console.Components
@using FlashAI.Modules.Accounts.Contracts
@using FlashAI.Modules.Activity.Contracts
@using FlashAI.Modules.Connections.Contracts

<aside class="account-inspector @(Account is null ? "is-empty" : "")" role="complementary" aria-label="Chi tiết tài khoản">
    @if (Account is null)
    {
        <div class="inspector-empty-state">
            <div class="empty-inspector-mark" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="3"></rect>
                    <path d="M9 3v18"></path>
                    <path d="M14 8h4M14 12h4M14 16h3"></path>
                </svg>
            </div>
            <strong>Chưa chọn tài khoản</strong>
            <span>Chọn một dòng trong danh sách để xem thông tin đã ghi nhận.</span>
        </div>
    }
    else
    {
        <div class="inspector-header">
            <h2 class="inspector-title">Chi tiết tài khoản</h2>
        </div>

        <div class="inspector-body">
            <section class="identity-panel" aria-labelledby="account-identity-title">
                <PlatformLogo Provider="@Account.Provider" Size="52" />
                <div class="identity-copy">
                    <div class="identity-heading">
                        <h3 id="account-identity-title">@FormatProviderName(Account.Provider)</h3>
                        <span class="status-pill @GetStatusClass(Account)">
                            <span class="status-dot"></span>
                            @GetStatusLabel(Account)
                        </span>
                    </div>
                    <span class="identity-email" title="@Account.Email">@Account.Email</span>
                </div>
            </section>

            <section class="detail-section account-status-section" aria-labelledby="account-status-title">
                <div class="section-heading">
                    <h3 id="account-status-title">Trạng thái</h3>
                </div>
                <div class="session-observation">
                    <div class="observation-line">
                        <span class="detail-label">Danh tính</span>
                        <span class="state-chip @GetIdentityStateClass(Account.IdentityVerificationState)">@FormatIdentityState(Account.IdentityVerificationState)</span>
                    </div>
                    <div class="observation-line">
                        <span class="detail-label">Trình duyệt</span>
                        <span class="state-chip @GetRuntimeStateClass()">@GetRuntimeStateText()</span>
                    </div>
                </div>
            </section>

            <section class="detail-section usage-section" aria-labelledby="usage-details-title">
                <div class="usage-widget-heading">
                    <div class="usage-brand">
                        <div>
                            <h3 id="usage-details-title">Gói và hạn mức</h3>
                            <span class="usage-identity">@GetQuotaSourceLabel()</span>
                        </div>
                    </div>
                    @if (GetCodexPlanType() is string plan)
                    {
                        <span class="usage-plan-badge">@FormatPlanType(plan)</span>
                    }
                </div>
                @if (GetCodexQuotaRows().Any(usage => usage.IsStale))
                {
                    <div class="usage-refresh-status is-stale" role="status">Dữ liệu gần nhất đã cũ</div>
                }
                @if (GetCodexQuotaRows().Any())
                {
                    <div class="codex-quota-list">
                        @foreach (var usage in GetCodexQuotaRows())
                        {
                            var remaining = GetRemainingPercentage(usage);
                            <div class="codex-quota-row">
                                <div class="codex-quota-label">
                                    <strong>@FormatUsageWindow(usage)</strong>
                                    <span>@(remaining is decimal value ? $"{value:0.#}% còn lại" : "Chưa có số liệu")</span>
                                </div>
                                @if (remaining is decimal percent)
                                {
                                    <div class="codex-quota-progress" role="progressbar" aria-label="@FormatUsageWindow(usage), còn @percent.ToString("0.#") phần trăm" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent">
                                        <span style="width:@percent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                    </div>
                                }
                                @if (usage.ResetAtUtc is DateTimeOffset resetAt)
                                {
                                    <small>Làm mới @resetAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="usage-empty" role="status">
                        @(IsUsageRefreshRunning
                            ? "Đang đọc gói và hạn mức từ phiên ChatGPT…"
                            : string.IsNullOrWhiteSpace(UsageRefreshMessage)
                                ? "Đăng nhập tài khoản để tự động đọc gói và hạn mức."
                                : UsageRefreshMessage)
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(UsageRefreshMessage) && GetCodexQuotaRows().Any())
                {
                    <div class="usage-refresh-status" role="status">@UsageRefreshMessage</div>
                }
                @if (GetCodexLastUpdated() is DateTimeOffset updatedAt)
                {
                    <div class="usage-last-updated">Cập nhật @updatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                }
            </section>
            <section class="notes-section" aria-labelledby="notes-title">
                <div class="section-heading">
                    <h3 id="notes-title">Ghi chú</h3>
                    @if (_isDirty)
                    {
                        <span class="unsaved-label">Chưa lưu</span>
                    }
                </div>
                <textarea class="notes-textarea"
                          placeholder="Nhập ghi chú cho tài khoản này..."
                          @bind="_editableNotes"
                          rows="3"
                          aria-label="Ghi chú tài khoản"></textarea>
                @if (_isDirty)
                {
                    <div class="notes-actions">
                        <button type="button" class="notes-save-btn" @onclick="SaveNotes">Lưu ghi chú</button>
                    </div>
                }
            </section>

            <section class="actions-section" aria-label="Hành động tài khoản">
                <button type="button" class="action-btn btn-launch" @onclick="() => OnOpenAccount.InvokeAsync(Account)" title="@BrowserActionTitle">
                    <span>@BrowserActionLabel</span>
                </button>
                @if (BrowserRuntime?.RuntimeState == AccountBrowserRuntimeState.Open)
                {
                    <button type="button" class="action-btn btn-edit" @onclick="() => OnCloseBrowser.InvokeAsync(Account)" title="Đóng phiên trình duyệt của tài khoản này">
                        <span>Đóng trình duyệt</span>
                    </button>
                }
                <button type="button" class="action-btn btn-relogin" @onclick="() => OnLoginAgain.InvokeAsync(Account)" title="Đăng nhập lại tài khoản này">
                    <span>Đăng nhập lại</span>
                </button>
                <button type="button" class="action-btn btn-edit" @onclick="() => OnEditAccount.InvokeAsync(Account)" title="Chỉnh sửa thông tin tài khoản">
                    <span>Sửa thông tin</span>
                </button>
                <button type="button" class="action-btn btn-copy" @onclick="HandleCopyAccount" title="Sao chép thông tin đăng nhập sau khi xác nhận">
                    <span>Sao chép tài khoản</span>
                </button>
                <button type="button" class="action-btn btn-delete" @onclick="() => OnDeleteAccount.InvokeAsync(Account)" title="Xóa vĩnh viễn tài khoản cùng dữ liệu liên quan">
                    <span>Xóa vĩnh viễn</span>
                </button>
            </section>

            <section class="activity-section" aria-labelledby="activity-title">
                <div class="section-heading">
                    <h3 id="activity-title">Nhật ký hoạt động</h3>
                    <div class="activity-heading-actions">
                        <button type="button" class="activity-console-btn" @onclick="() => OnOpenConsoleLog.InvokeAsync(Account.AccountId)" title="Mở nhật ký hoạt động">
                            Xem nhật ký
                        </button>
                    </div>
                </div>
            </section>
        </div>
    }
</aside>

@code {
    [Parameter] public AccountDetailVm? Account { get; set; }
    [Parameter] public IReadOnlyList<ActivityEventVm> ActivityEvents { get; set; } = [];
    [Parameter] public BrowserRuntimeSnapshot? BrowserRuntime { get; set; }
    [Parameter] public AccountUsageView? Usage { get; set; }
    [Parameter] public bool IsUsageRefreshRunning { get; set; }
    [Parameter] public string? UsageRefreshMessage { get; set; }
    [Parameter] public ProviderAccountObservationSnapshot? Observation { get; set; }
    [Parameter] public EventCallback<AccountDetailVm> OnOpenAccount { get; set; }
    [Parameter] public EventCallback<AccountDetailVm> OnLoginAgain { get; set; }
    [Parameter] public EventCallback<AccountDetailVm> OnCloseBrowser { get; set; }
    [Parameter] public EventCallback<AccountDetailVm> OnEditAccount { get; set; }
    [Parameter] public EventCallback<AccountDetailVm> OnDeleteAccount { get; set; }
    [Parameter] public EventCallback<(Guid Id, string Notes)> OnSaveNotes { get; set; }
    [Parameter] public EventCallback<Guid> OnCopyAccount { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenConsoleLog { get; set; }

    private string _editableNotes = "";
    private Guid? _currentAccountId;
    private bool _isDirty => Account != null && _editableNotes != (Account.Notes ?? "");
    private bool HasActiveManagedAttempt
        => BrowserRuntime is { RuntimeState: AccountBrowserRuntimeState.Open, ActiveAttemptId: not null };
    private bool HasPendingManagedLogin
        => HasActiveManagedAttempt
            && BrowserRuntime?.AuthenticationState != AuthenticationObservationStatus.AuthenticatedSessionConfirmed;
    private string BrowserActionLabel
        => HasPendingManagedLogin ? "Tiếp tục đăng nhập" : HasActiveManagedAttempt ? "Kiểm tra phiên" : "Mở trình duyệt";
    private string BrowserActionTitle
        => HasPendingManagedLogin
            ? "Tiếp tục trong đúng cửa sổ Chrome đang mở; không gửi lại thông tin đăng nhập"
            : HasActiveManagedAttempt
                ? "Kiểm tra phiên ChatGPT trong cửa sổ đang mở"
                : "Mở phiên trình duyệt ChatGPT của tài khoản này";

    private ProviderAccountFieldEvidence? ObservationField(ProviderAccountObservationField field)
        => Observation?.Fields.FirstOrDefault(item => item.Field == field);

    protected override void OnParametersSet()
    {
        if (Account != null && Account.AccountId != _currentAccountId)
        {
            _currentAccountId = Account.AccountId;
            _editableNotes = Account.Notes ?? "";
        }
    }

    private async Task HandleCopyAccount()
    {
        if (Account != null)
        {
            await OnCopyAccount.InvokeAsync(Account.AccountId);
        }
    }

    private async Task SaveNotes()
    {
        if (Account != null)
        {
            await OnSaveNotes.InvokeAsync((Account.AccountId, _editableNotes));
        }
    }

    private static bool IsActive(AccountDetailVm account)
        => account.AuthenticationState.Equals("AuthenticatedSessionConfirmed", StringComparison.OrdinalIgnoreCase);
    private static bool IsUnverified(string status) => status.Equals("Unverified", StringComparison.OrdinalIgnoreCase);

    private static bool Has2Fa(AccountDetailVm account)
        => account.Tags?.Any(t => t.Contains("2fa", StringComparison.OrdinalIgnoreCase)) == true;

    private static string GetTwoFactorText(AccountDetailVm account)
        => Has2Fa(account) ? "Đã lưu mã xác minh hai bước" : "Chưa lưu mã xác minh hai bước";

    private static string FormatProviderEvidence(ProviderAccountFieldEvidence? field, string unavailableLabel)
    {
        if (field is null)
        {
            return unavailableLabel;
        }

        if (field.Field == ProviderAccountObservationField.Email
            && field.EvidenceType == "VerifiedChatGptUsageBindingV1")
        {
            return "Đã khớp với tài khoản đang chọn";
        }

        if (field.Field == ProviderAccountObservationField.Plan
            && field.Status == ProviderAccountObservationFieldStatus.Observed
            && !string.IsNullOrWhiteSpace(field.Value))
        {
            return FormatPlanType(field.Value);
        }

        if (field.Field == ProviderAccountObservationField.MfaConfiguration
            && field.Status == ProviderAccountObservationFieldStatus.Observed
            && !string.IsNullOrWhiteSpace(field.Value))
        {
            return field.Value.Trim().ToLowerInvariant() switch
            {
                "unknown" => "Chưa xác minh",
                "enabled" or "true" => "Đã bật",
                "disabled" or "false" => "Đã tắt",
                _ => "Đã ghi nhận"
            };
        }

        if (field.Field == ProviderAccountObservationField.UsageQuota
            && field.Status == ProviderAccountObservationFieldStatus.Observed
            && field.EvidenceType == "ChatGptWebUsageV1"
            && ChatGptWebUsageSnapshotCodec.TryDeserialize(field.Value, out var usage)
            && usage is not null)
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(usage.PlanType))
            {
                parts.Add($"Gói {FormatPlanType(usage.PlanType)}");
            }
            AddWindowSummary(usage.PrimaryWindow);
            AddWindowSummary(usage.SecondaryWindow);
            return parts.Count > 0 ? string.Join(" · ", parts) : "ChatGPT chưa cung cấp hạn mức";

            void AddWindowSummary(ChatGptUsageWindowSnapshot? window)
            {
                if (window is null)
                {
                    return;
                }

                var label = window.LimitWindowSeconds is long seconds
                    ? FormatWindowDuration(seconds)
                    : "Hạn mức";
                var detail = window.UsedPercent is decimal percent
                    ? $"còn {Math.Clamp(100m - percent, 0m, 100m):0.#}% · đã dùng {percent:0.#}%"
                    : "đang cập nhật";
                if (window.ResetAtUtc is DateTimeOffset resetAt)
                {
                    detail += $" · làm mới {resetAt.ToLocalTime():dd/MM HH:mm}";
                }
                else if (window.ResetAfterSeconds is long resetAfter)
                {
                    detail += $" · làm mới sau {FormatWindowDuration(resetAfter)}";
                }
                parts.Add($"{label}: {detail}");
            }
        }

        return field.Status switch
        {
            ProviderAccountObservationFieldStatus.Observed when !string.IsNullOrWhiteSpace(field.Value) => field.Value,
            ProviderAccountObservationFieldStatus.Unsupported => "Chưa có dữ liệu phù hợp; không hiển thị số ước tính",
            ProviderAccountObservationFieldStatus.Failed => "Không thể đọc",
            _ => unavailableLabel
        };
    }

    private static string FormatEvidenceStatus(ProviderAccountFieldEvidence? field)
        => field?.Status switch
        {
            ProviderAccountObservationFieldStatus.Observed => field.EvidenceType == "VerifiedChatGptUsageBindingV1" ? "Đã xác minh" : "Đã ghi nhận",
            ProviderAccountObservationFieldStatus.Unsupported => "Chưa có dữ liệu",
            ProviderAccountObservationFieldStatus.Failed => "Đọc thất bại",
            ProviderAccountObservationFieldStatus.Unavailable => "Chưa có dữ liệu",
            _ => "Chưa ghi nhận"
        };

    private static string GetEvidenceStateClass(ProviderAccountFieldEvidence? field)
        => field?.Status switch
        {
            ProviderAccountObservationFieldStatus.Observed => "state-success",
            ProviderAccountObservationFieldStatus.Failed => "state-danger",
            ProviderAccountObservationFieldStatus.Unsupported => "state-warning",
            _ => "state-neutral"
        };

    private string GetMfaObservationText()
    {
        if (ActivityEvents.Any(item => item.EventType.Equals("AuthenticatedSessionConfirmed", StringComparison.OrdinalIgnoreCase)))
        {
            return "Phiên đã được xác nhận sau MFA";
        }

        if (ActivityEvents.Any(item => item.EventType.Equals("AdditionalMfaRequired", StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.ErrorCode, "ADDITIONAL_MFA_REQUIRED", StringComparison.OrdinalIgnoreCase)))
        {
            return "Provider yêu cầu xác thực bổ sung";
        }

        if (ActivityEvents.Any(item => item.EventType.Equals("HumanActionRequired", StringComparison.OrdinalIgnoreCase)))
        {
            return "Đang chờ thao tác thủ công trong Chrome";
        }

        return ActivityEvents.Any(item => item.EventType.Equals("TotpSubmitted", StringComparison.OrdinalIgnoreCase))
            ? "Đã gửi mã; đang chờ ChatGPT xác nhận"
            : "Chưa quan sát bước gửi mã";
    }

    private string GetCandidateProfileText()
    {
        if (ActivityEvents.Any(item => item.EventType.Equals("CandidatePromotionCommitted", StringComparison.OrdinalIgnoreCase)))
        {
            return "Đã thay hồ sơ sau khi xác minh tài khoản";
        }

        if (ActivityEvents.Any(item => item.EventType.Equals("CandidateReadyForPromotion", StringComparison.OrdinalIgnoreCase)))
        {
            return "Đang chờ xác minh; hồ sơ hiện tại vẫn được giữ nguyên";
        }

        if (ActivityEvents.Any(item => item.EventType.Equals("CandidateReadyForObservation", StringComparison.OrdinalIgnoreCase)))
        {
            return "Đang kiểm tra hồ sơ đăng nhập mới; hồ sơ hiện tại vẫn được giữ nguyên";
        }

        return "Không có hồ sơ mới cần xác minh";
    }

    private static bool IsCredentialReady(AccountDetailVm account)
        => account.CredentialReferencePresent;

    private static string GetCredentialReferenceText(AccountDetailVm account)
        => IsCredentialReady(account) ? "Đã lưu trong kho bảo mật" : "Chưa ghi nhận";

    private static string GetSessionStateText(AccountDetailVm account)
        => account.AuthenticationState switch
        {
            "AuthenticatedSessionConfirmed" => "Phiên đã xác thực",
            "PostLoginPending" => "Đang chờ ChatGPT xác nhận mã",
            "LoginInProgress" or "MfaRequired" => "Đang xác minh phiên",
            "WaitingForUser" => "Cần thao tác người dùng",
            "InvalidCredentials" => "Thông tin không hợp lệ",
            _ => "Chưa xác minh"
        };

    private static string GetSessionStateClass(AccountDetailVm account)
        => account.AuthenticationState == "AuthenticatedSessionConfirmed"
            ? "state-success"
            : account.AuthenticationState is "PostLoginPending" or "InvalidCredentials" or "WaitingForUser" ? "state-warning" : "state-neutral";

    private string GetRuntimeStateText()
        => BrowserRuntime?.RuntimeState switch
        {
            AccountBrowserRuntimeState.Open => "Đang mở",
            AccountBrowserRuntimeState.Launching => "Đang khởi chạy",
            AccountBrowserRuntimeState.Closing => "Đang đóng",
            AccountBrowserRuntimeState.Crashed => "Đã dừng bất thường",
            AccountBrowserRuntimeState.ProfileInUse => "Profile đang được dùng",
            AccountBrowserRuntimeState.Disconnected => "Mất kết nối",
            AccountBrowserRuntimeState.Unknown => "Chưa xác định",
            _ => "Đã đóng"
        };

    private string GetRuntimeStateClass()
        => BrowserRuntime?.RuntimeState switch
        {
            AccountBrowserRuntimeState.Open => "state-success",
            AccountBrowserRuntimeState.Launching or AccountBrowserRuntimeState.Closing or AccountBrowserRuntimeState.ProfileInUse => "state-warning",
            AccountBrowserRuntimeState.Crashed or AccountBrowserRuntimeState.Disconnected => "state-danger",
            _ => "state-neutral"
        };

    private static string FormatCloseReason(BrowserCloseReason reason)
        => reason switch
        {
            BrowserCloseReason.UserRequested => "Người dùng yêu cầu",
            BrowserCloseReason.LeaseExpired => "Lease hết hạn",
            BrowserCloseReason.CancellationRequested => "Đã hủy attempt",
            BrowserCloseReason.ContextDisposed => "Playwright context đã dispose",
            BrowserCloseReason.BrowserProcessExited => "Browser process đã thoát",
            BrowserCloseReason.NavigationFailure => "Lỗi navigation",
            _ => "Chưa xác định"
        };

    private static string FormatUsageValue(decimal? value, string? unit)
        => value.HasValue
            ? string.Equals(unit, "percent", StringComparison.OrdinalIgnoreCase)
                ? $"{value.Value:0.#}%"
                : $"{value.Value:0.##} {unit}"
            : "Chưa có nguồn";

    private static string FormatPlanType(string value)
        => value.Trim().ToLowerInvariant() switch
        {
            "free" => "Miễn phí",
            "plus" => "Plus",
            "pro" => "Pro",
            "team" => "Nhóm",
            "business" => "Business",
            "enterprise" => "Enterprise",
            _ => value
        };

    private string? GetCodexPlanType()
        => GetCodexQuotaRows()
            .Select(item => item.PlanType)
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));

    private string GetQuotaSourceLabel()
    {
        var product = GetCodexQuotaRows().Select(item => item.ProductId).FirstOrDefault();
        if (string.Equals(product, "ChatGPTWeb", StringComparison.OrdinalIgnoreCase)) return "ChatGPT";
        if (string.Equals(product, "CodexCLI", StringComparison.OrdinalIgnoreCase)) return "Codex CLI";
        return IsUsageRefreshRunning ? "Đang đồng bộ" : "Chưa có dữ liệu";
    }

    private IEnumerable<AccountUsageSnapshot> GetCodexQuotaRows()
    {
        if (Account is null || Usage is null || Usage.AccountId != Account.AccountId)
        {
            return [];
        }

        var candidates = Usage.Snapshots
            .Where(usage => IsVerifiedCodexUsage(usage)
                && usage.AccountId == Account.AccountId
                && !usage.CapabilityStatus.Equals("Unsupported", StringComparison.OrdinalIgnoreCase)
                && usage.IdentityBindingStatus is UsageIdentityBindingStatus.ProviderIdentityVerified or UsageIdentityBindingStatus.ConnectionScoped)
            .ToArray();
        if (candidates.Length == 0)
        {
            return [];
        }

        // Only render one coherent snapshot. Prefer the source observed most
        // recently so an authenticated ChatGPT refresh immediately replaces an
        // older CLI snapshot without mixing windows from different sessions.
        var newestProduct = candidates
            .GroupBy(usage => usage.ProductId, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(group => group.Max(usage => usage.ObservedAtUtc))
            .Select(group => group.Key)
            .First();

        return candidates
            .Where(usage => string.Equals(usage.ProductId, newestProduct, StringComparison.OrdinalIgnoreCase))
            .OrderBy(usage => usage.WindowDurationSeconds ?? long.MaxValue)
            .ToArray();
    }

    private string GetCodexIdentity()
    {
        var identity = GetCodexQuotaRows()
            .Select(item => item.VerifiedAccountIdentity)
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
        if (identity is null)
        {
            return "Danh tính chưa xác minh";
        }

        var at = identity.IndexOf('@');
        return at > 2 ? $"{identity[..2]}…{identity[at..]}" : identity;
    }

    private DateTimeOffset? GetCodexLastUpdated()
        => GetCodexQuotaRows()
            .Select(item => (DateTimeOffset?)item.ObservedAtUtc)
            .Max();

    private static bool IsVerifiedCodexUsage(AccountUsageSnapshot usage)
        => (string.Equals(usage.ProductId, "CodexCLI", StringComparison.OrdinalIgnoreCase)
                || string.Equals(usage.ProductId, "ChatGPTWeb", StringComparison.OrdinalIgnoreCase))
            && usage.Capability == FlashAI.Modules.Connections.Features.ProviderIntegration.Abstractions.ProviderCapability.Quota;

    private static string FormatEvidenceSource(string? source)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return "Chưa ghi nhận";
        }

        if (source.Contains("Codex CLI", StringComparison.OrdinalIgnoreCase))
        {
            return "Gói và hạn mức từ Codex CLI";
        }
        if (source.Contains("wham/usage", StringComparison.OrdinalIgnoreCase))
        {
            return "Gói và hạn mức từ ChatGPT";
        }
        if (source.Contains("account-menu", StringComparison.OrdinalIgnoreCase)
            || source.Contains("account UI", StringComparison.OrdinalIgnoreCase)
            || source.Contains("Settings UI", StringComparison.OrdinalIgnoreCase))
        {
            return "Giao diện tài khoản ChatGPT";
        }
        if (source.Contains("page-state", StringComparison.OrdinalIgnoreCase))
        {
            return "Trang đăng nhập ChatGPT";
        }

        return "ChatGPT";
    }

    private static string FormatAccountDataSource(string? source)
        => "Lưu trữ trong ứng dụng trên thiết bị này";

    private static string FormatObservationError(string? code)
        => code?.ToUpperInvariant() switch
        {
            null or "" => "Chưa có lỗi",
            "ADDITIONAL_MFA_REQUIRED" => "ChatGPT yêu cầu xác minh thêm",
            "ADDITIONAL_MFA_LEASE_EXPIRED" => "Hết thời gian xác minh. Đăng nhập lại để tiếp tục.",
            "IDENTITY_EMAIL_MISMATCH" => "Tài khoản đăng nhập không khớp",
            "IDENTITY_EMAIL_UNAVAILABLE" or "IDENTITY_EVIDENCE_INSUFFICIENT" => "Chưa xác minh được tài khoản",
            "SESSION_NOT_CONFIRMED" or "USAGE_API_UNAUTHORIZED" => "Phiên chưa đăng nhập hoặc đã hết hạn",
            "USAGE_API_RATE_LIMITED" => "ChatGPT đang giới hạn yêu cầu",
            _ => "Chưa hoàn tất xác minh"
        };

    private static string FormatWindowDuration(long seconds)
    {
        if (seconds >= 3600 && seconds % 3600 == 0)
        {
            return $"{seconds / 3600} giờ";
        }

        if (seconds >= 60 && seconds % 60 == 0)
        {
            return $"{seconds / 60} phút";
        }

        return $"{seconds} giây";
    }

    private static decimal? GetRemainingPercentage(AccountUsageSnapshot usage)
    {
        var remaining = usage.RemainingPercentage
            ?? (usage.UsedPercentage is >= 0 and <= 100 ? 100m - usage.UsedPercentage.Value : null);
        return remaining is >= 0 and <= 100 ? remaining : null;
    }

    private static string FormatUsageWindow(AccountUsageSnapshot usage)
        => usage.WindowType switch
        {
            AccountUsageWindowType.FiveHours => "5 giờ",
            AccountUsageWindowType.Week => "1 tuần",
            AccountUsageWindowType.BillingPeriod => "Kỳ thanh toán",
            AccountUsageWindowType.Rolling => "Khoảng thời gian luân phiên",
            AccountUsageWindowType.Other when usage.WindowDurationSeconds is long seconds => FormatWindowDuration(seconds),
            AccountUsageWindowType.Other => "Khoảng thời gian khác",
            _ => "Thời hạn chưa rõ"
        };

    private static string GetStatusClass(AccountDetailVm account)
    {
        if (IsActive(account)) return "status-active";
        if (IsUnverified(account.Status) || account.AuthenticationState.Equals("LoginInProgress", StringComparison.OrdinalIgnoreCase)) return "status-unverified";
        if (account.Status.Equals("ReauthNeeded", StringComparison.OrdinalIgnoreCase)) return "status-warning";
        return "status-failed";
    }

    private static string GetStatusLabel(AccountDetailVm account)
        => account.AuthenticationState.Equals("AuthenticatedSessionConfirmed", StringComparison.OrdinalIgnoreCase)
            ? "Đã xác minh phiên"
            : account.AuthenticationState.Equals("LoginInProgress", StringComparison.OrdinalIgnoreCase)
                ? "Đang đăng nhập"
                : string.IsNullOrWhiteSpace(account.StatusLabel) ? "Chưa xác minh" : account.StatusLabel;

    private static string FormatIdentityState(string state)
        => state switch
        {
            "IdentityVerified" => "Đã xác minh danh tính",
            "IdentityObserved" => "Đã quan sát danh tính",
            "Mismatch" => "Danh tính không khớp",
            "Unverified" => "Chưa đủ bằng chứng",
            "PartiallyResolved" => "Xác minh một phần",
            "Unsupported" => "Không hỗ trợ",
            "Unauthorized" => "Chưa được cấp quyền",
            "Checking" => "Đang xác minh",
            _ => "Chờ xác minh danh tính"
        };

    private static string GetIdentityStateClass(string state)
        => state switch
        {
            "IdentityVerified" => "state-success",
            "Mismatch" => "state-danger",
            "Checking" or "IdentityObserved" => "state-warning",
            _ => "state-neutral"
        };

    private static string FormatProviderName(string provider)
    {
        if (provider.Contains("chatgpt", StringComparison.OrdinalIgnoreCase) || provider.Contains("openai", StringComparison.OrdinalIgnoreCase)) return "ChatGPT";
        if (provider.Contains("claude", StringComparison.OrdinalIgnoreCase) || provider.Contains("anthropic", StringComparison.OrdinalIgnoreCase)) return "Claude";
        if (provider.Contains("gemini", StringComparison.OrdinalIgnoreCase) || provider.Contains("google", StringComparison.OrdinalIgnoreCase)) return "Gemini";
        if (provider.Contains("perplexity", StringComparison.OrdinalIgnoreCase)) return "Perplexity";
        if (provider.Contains("huflit", StringComparison.OrdinalIgnoreCase)) return "HUFLIT";
        return provider;
    }

    private static string FormatPlan(string plan)
        => string.IsNullOrWhiteSpace(plan) || plan.Equals("Chưa rõ", StringComparison.OrdinalIgnoreCase)
            ? "Chưa xác minh"
            : FormatPlanType(plan);

    private static string FormatDate(DateTimeOffset? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa ghi nhận";

    private static string FormatActivitySeverity(string severity)
        => severity.ToUpperInvariant() switch
        {
            "SUCCESS" or "PASS" => "Thành công",
            "WARNING" or "WARN" => "Cảnh báo",
            "ERROR" => "Lỗi",
            _ => "Thông tin"
        };

    private static string FormatActivitySummary(ActivityEventVm item)
        => item.EventType switch
        {
            "GuestLandingDetected" => "ChatGPT chưa đăng nhập",
            "AdditionalMfaRequired" or "MfaRequired" => "ChatGPT yêu cầu xác minh thêm",
            "TotpSubmitted" => "Đã gửi mã xác minh hai bước",
            "AuthenticatedSessionConfirmed" => "Đã xác nhận phiên đăng nhập",
            "BrowserSessionObserved" => "Đã kiểm tra phiên đăng nhập",
            "OfficialNavigationStarted" => "Đang mở trang ChatGPT",
            "OfficialNavigationSucceeded" or "OfficialChatGPTReached" => "Đã mở ChatGPT",
            "IdentityResolutionPending" => "Đang xác minh tài khoản",
            "IdentityResolutionPartial" or "IdentityResolutionUnsupported" => "Chưa đủ thông tin để xác minh tài khoản",
            "ChatGptUsageApiObserved" => "Đã cập nhật gói và hạn mức",
            "ChatGptUsageApiFailed" => "Chưa cập nhật được gói và hạn mức",
            "AccountObservationStarted" => "Đang đọc thông tin tài khoản",
            "AccountObservationCompleted" => "Đã cập nhật thông tin tài khoản",
            "AccountObservationPartial" or "AccountObservationFailed" => "Chưa đọc đủ thông tin tài khoản",
            "BrowserClosed" => "Đã đóng trình duyệt",
            "BrowserCrashed" or "BrowserDisconnected" => "Trình duyệt đã dừng",
            "AttemptCancelled" => "Đã dừng đăng nhập",
            "CandidateReadyForPromotion" => "Hồ sơ đăng nhập mới đang chờ xác minh",
            "CandidatePromotionCommitted" => "Đã lưu hồ sơ đăng nhập mới",
            "AuthenticationAttemptCompleted" when item.ErrorCode == "ADDITIONAL_MFA_REQUIRED" => "ChatGPT yêu cầu xác minh thêm",
            "AuthenticationAttemptCompleted" => "Quá trình đăng nhập chưa hoàn tất",
            _ when item.Severity.Equals("Error", StringComparison.OrdinalIgnoreCase) => "Có lỗi cần kiểm tra",
            _ when item.Severity.Equals("Warning", StringComparison.OrdinalIgnoreCase) => "Cần hoàn tất một bước kiểm tra",
            _ => "Có cập nhật tài khoản"
        };

    private static string GetSeverityDotClass(string severity)
        => severity.ToUpperInvariant() switch
        {
            "SUCCESS" or "PASS" => "dot-green",
            "WARNING" or "WARN" => "dot-amber",
            "ERROR" => "dot-red",
            _ => "dot-blue"
        };
}
