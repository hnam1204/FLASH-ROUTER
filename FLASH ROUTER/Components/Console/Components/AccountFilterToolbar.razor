@namespace FLASH_ROUTER.Components.Console.Components

<div class="account-filter-toolbar" role="toolbar" aria-label="Bộ lọc và công cụ tài khoản">
    <div class="toolbar-left">
        <!-- Platform Filter Dropdown -->
        <div class="filter-select-wrapper">
            <svg class="filter-prefix-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <path d="M3 9h18"></path>
                <path d="M9 21V9"></path>
            </svg>
            <select class="filter-select" value="@SelectedPlatform" @onchange="HandlePlatformChange" aria-label="Lọc theo nền tảng">
                <option value="all">Tất cả nền tảng</option>
                <option value="chatgpt">ChatGPT</option>
                <option value="claude">Claude</option>
                <option value="gemini">Gemini</option>
                <option value="perplexity">Perplexity</option>
                <option value="huflit">HUFLIT</option>
            </select>
            <svg class="select-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>

        <!-- Status Filter Dropdown -->
        <div class="filter-select-wrapper">
            <svg class="filter-prefix-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <select class="filter-select" value="@SelectedStatus" @onchange="HandleStatusChange" aria-label="Lọc theo trạng thái">
                <option value="all">Tất cả trạng thái</option>
                <option value="connected">Đang hoạt động</option>
                <option value="unverified">Cần xác minh</option>
                <option value="expired">Hết phiên</option>
                <option value="failed">Đã lỗi</option>
            </select>
            <svg class="select-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>

        <!-- Inline Table Search Input -->
        <div class="table-search-box">
            <svg class="search-box-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text"
                   class="table-search-input"
                   placeholder="Tìm kiếm email, tài khoản..."
                   value="@TableSearchText"
                   @oninput="HandleSearchInput"
                   aria-label="Tìm kiếm email, tài khoản" />
        </div>
    </div>

    <div class="toolbar-right">
        <!-- Refresh Button -->
        <button type="button"
                class="toolbar-icon-btn"
                @onclick="HandleRefresh"
                title="Làm mới danh sách"
                aria-label="Làm mới danh sách">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
        </button>

        <!-- Add Account Primary Button -->
        <button type="button"
                class="add-account-btn"
                @onclick="HandleAddAccount"
                aria-label="Thêm account mới">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Thêm account</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public string SelectedPlatform { get; set; } = "all";
    [Parameter] public EventCallback<string> OnPlatformChanged { get; set; }
    [Parameter] public string SelectedStatus { get; set; } = "all";
    [Parameter] public EventCallback<string> OnStatusChanged { get; set; }
    [Parameter] public string TableSearchText { get; set; } = "";
    [Parameter] public EventCallback<string> OnTableSearchChanged { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnAddAccount { get; set; }

    private async Task HandlePlatformChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "all";
        await OnPlatformChanged.InvokeAsync(val);
    }

    private async Task HandleStatusChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "all";
        await OnStatusChanged.InvokeAsync(val);
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        await OnTableSearchChanged.InvokeAsync(val);
    }

    private async Task HandleRefresh()
    {
        await OnRefresh.InvokeAsync();
    }

    private async Task HandleAddAccount()
    {
        await OnAddAccount.InvokeAsync();
    }
}
