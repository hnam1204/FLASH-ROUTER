@namespace FLASH_ROUTER.Components.Console.Components
@using FlashAI.Foundation.Security
@using FlashAI.Modules.Accounts.Contracts

@if (IsOpen)
{
    <div class="flash-overlay-backdrop" @onclick="HandleClose">
        <div class="flash-modal-card add-account-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="add-account-title">
            <div class="flash-modal-header">
                <h3 id="add-account-title" class="flash-modal-title">Thêm tài khoản</h3>
                <button type="button" class="flash-modal-close-btn" @onclick="HandleClose" aria-label="Đóng">✕</button>
            </div>

            <div class="flash-modal-body">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="modal-error-banner" role="alert">@_errorMessage</div>
                }

                <div class="modal-form-group">
                    <label class="form-label" for="add-platform">Provider</label>
                    <select id="add-platform" class="modal-select" @bind="_provider">
                        <option value="openai-chatgpt">ChatGPT</option>
                        <option value="anthropic-claude" disabled>Claude (chưa hỗ trợ tự động)</option>
                        <option value="google-gemini" disabled>Gemini (chưa hỗ trợ tự động)</option>
                        <option value="openrouter" disabled>OpenRouter (dùng kết nối API)</option>
                    </select>
                </div>

                <div class="modal-form-group">
                    <div class="label-with-badge">
                        <label for="quick-credential-input" class="form-label">Credential</label>
                        <span class="label-format-badge">EMAIL|PASSWORD|2FA</span>
                    </div>
                    <div class="credential-input-box">
                        <input id="quick-credential-input"
                               type="password"
                               class="modal-input"
                               placeholder="email|password|totp_seed (tùy chọn)"
                               @bind="_credentialLine"
                               autocomplete="off" />
                    </div>
                    <span class="field-help">Dùng dấu ngoặc kép hoặc escape <code>\|</code> nếu password chứa dấu <code>|</code>. TOTP phải là secret seed, không phải mã sáu số.</span>
                </div>

                <div class="modal-form-group">
                    <label class="form-label" for="add-notes">Notes</label>
                    <textarea id="add-notes" class="modal-textarea" rows="4" maxlength="1000" placeholder="Ghi chú tùy chọn..." @bind="_notes"></textarea>
                </div>
            </div>

            <div class="flash-modal-footer">
                <button type="button" class="flash-btn flash-btn-outline" @onclick="HandleClose">Hủy</button>
                <button type="button" class="flash-btn flash-btn-primary" @onclick="HandleSave">Lưu và tự động đăng nhập</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CreateAccountRequest> OnSave { get; set; }

    private string _provider = "openai-chatgpt";
    private string _credentialLine = string.Empty;
    private string _notes = string.Empty;
    private string? _errorMessage;

    private async Task HandleSave()
    {
        _errorMessage = null;
        if (!CredentialLineCodec.TryParse(_credentialLine, out var credential, out var error) || credential is null)
        {
            _errorMessage = error;
            return;
        }

        await OnSave.InvokeAsync(new CreateAccountRequest
        {
            Profile = new AccountEditorVm
            {
                Email = credential.Account,
                DisplayName = credential.Account.Split('@')[0],
                Provider = _provider,
                RecordedPlan = "Chưa rõ",
                Status = "Unverified",
                Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
                Tags = [_provider]
            },
            CredentialLine = _credentialLine,
            OpenBrowserAfterSave = true
        });

        ResetForm();
    }

    private async Task HandleClose()
    {
        ResetForm();
        await OnClose.InvokeAsync();
    }

    private void ResetForm()
    {
        _provider = "openai-chatgpt";
        _credentialLine = string.Empty;
        _notes = string.Empty;
        _errorMessage = null;
    }
}
