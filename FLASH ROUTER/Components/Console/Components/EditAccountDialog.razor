@namespace FLASH_ROUTER.Components.Console.Components
@using FlashAI.Modules.Accounts.Contracts
@using FlashAI.Modules.Connections.Contracts

@if (IsOpen && Account != null)
{
    <div class="flash-overlay-backdrop" @onclick="HandleClose">
        <div class="flash-modal-card edit-account-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="edit-account-title">
            <div class="flash-modal-header">
                <h3 id="edit-account-title" class="flash-modal-title">Chỉnh sửa thông tin</h3>
                <button type="button" class="flash-modal-close-btn" @onclick="HandleClose" aria-label="Đóng">✕</button>
            </div>

            <div class="flash-modal-body">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="modal-error-banner" role="alert">@_errorMessage</div>
                }

                <p class="edit-account-intro">Cập nhật email, thông tin đăng nhập hoặc ghi chú. Mật khẩu và mã 2FA cũ không hiển thị trong biểu mẫu.</p>

                <div class="modal-form-group">
                    <span class="form-label">Nền tảng</span>
                    <div class="readonly-field">@FormatProvider(Account.Provider)</div>
                </div>

                <div class="modal-form-group">
                    <label class="form-label" for="edit-email">Email</label>
                    <input id="edit-email" type="email" class="modal-input" @bind="_email" autocomplete="username" />
                    <span class="field-help">Email mới sẽ được dùng làm tên đăng nhập cho tài khoản này.</span>
                </div>

                <div class="modal-form-group">
                    <span class="form-label">Mật khẩu</span>
                    <div class="radio-options-row">
                        <label class="radio-label"><input type="radio" name="password-update" checked="@(_passwordAction == CredentialPasswordUpdate.Keep)" @onchange="() => _passwordAction = CredentialPasswordUpdate.Keep" /> Giữ mật khẩu hiện tại</label>
                        <label class="radio-label"><input type="radio" name="password-update" checked="@(_passwordAction == CredentialPasswordUpdate.Replace)" @onchange="() => _passwordAction = CredentialPasswordUpdate.Replace" /> Thay mật khẩu</label>
                    </div>
                    @if (_passwordAction == CredentialPasswordUpdate.Replace)
                    {
                        <input id="edit-password" type="password" class="modal-input" placeholder="Nhập mật khẩu mới" @bind="_replacementPassword" autocomplete="new-password" />
                    }
                    <span class="field-help">Mật khẩu hiện tại được giữ nguyên nếu bạn không chọn thay đổi.</span>
                </div>

                <div class="modal-form-group">
                    <span class="form-label">Xác minh hai bước (2FA)</span>
                    <div class="radio-options-row">
                        <label class="radio-label"><input type="radio" name="totp-update" checked="@(_totpAction == CredentialTotpUpdate.Keep)" @onchange="() => _totpAction = CredentialTotpUpdate.Keep" /> Giữ mã hiện tại</label>
                        <label class="radio-label"><input type="radio" name="totp-update" checked="@(_totpAction == CredentialTotpUpdate.Replace)" @onchange="() => _totpAction = CredentialTotpUpdate.Replace" /> Thay mã</label>
                        <label class="radio-label"><input type="radio" name="totp-update" checked="@(_totpAction == CredentialTotpUpdate.Remove)" @onchange="() => _totpAction = CredentialTotpUpdate.Remove" /> Xóa mã đã lưu</label>
                    </div>
                    @if (_totpAction == CredentialTotpUpdate.Replace)
                    {
                        <input id="edit-totp" type="password" class="modal-input" placeholder="Nhập mã bí mật 2FA mới" @bind="_replacementTotpSeed" autocomplete="off" />
                    }
                    <span class="field-help">Mã hiện tại luôn được ẩn. Xóa mã tại đây không tắt xác minh hai bước ở ChatGPT.</span>
                </div>

                <div class="modal-form-group">
                    <label class="form-label" for="edit-notes">Ghi chú</label>
                    <textarea id="edit-notes" class="modal-textarea" rows="3" maxlength="1000" @bind="_notes"></textarea>
                </div>
            </div>

            <div class="flash-modal-footer">
                <button type="button" class="flash-btn flash-btn-outline" @onclick="HandleClose">Hủy</button>
                <button type="button" class="flash-btn flash-btn-primary" @onclick="HandleSave">Lưu thay đổi</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public AccountDetailVm? Account { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(Guid Id, AccountEditorVm Model, CredentialUpdateInput? Credential)> OnSave { get; set; }

    private string _email = string.Empty;
    private string _replacementPassword = string.Empty;
    private string _replacementTotpSeed = string.Empty;
    private string _notes = string.Empty;
    private string? _errorMessage;
    private Guid? _lastLoadedId;
    private CredentialPasswordUpdate _passwordAction = CredentialPasswordUpdate.Keep;
    private CredentialTotpUpdate _totpAction = CredentialTotpUpdate.Keep;

    protected override void OnParametersSet()
    {
        if (Account != null && Account.AccountId != _lastLoadedId)
        {
            _lastLoadedId = Account.AccountId;
            _email = Account.Email;
            _notes = Account.Notes ?? string.Empty;
            _replacementPassword = string.Empty;
            _replacementTotpSeed = string.Empty;
            _passwordAction = CredentialPasswordUpdate.Keep;
            _totpAction = CredentialTotpUpdate.Keep;
            _errorMessage = null;
        }
    }

    private async Task HandleSave()
    {
        if (Account == null)
        {
            return;
        }

        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_email))
        {
            _errorMessage = "Email không được để trống.";
            return;
        }

        var profile = new AccountEditorVm
        {
            AccountId = Account.AccountId,
            Email = _email.Trim(),
            DisplayName = Account.DisplayName,
            Provider = Account.Provider,
            RecordedPlan = Account.RecordedPlan,
            Status = Account.Status,
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
            Tags = Account.Tags.ToList(),
            Version = Account.Version
        };
        var credentialChanged = !Account.Email.Equals(_email.Trim(), StringComparison.OrdinalIgnoreCase)
            || _passwordAction == CredentialPasswordUpdate.Replace
            || _totpAction != CredentialTotpUpdate.Keep;
        var credential = credentialChanged
            ? new CredentialUpdateInput(_email.Trim(), _passwordAction, _replacementPassword, _totpAction, _replacementTotpSeed)
            : null;

        await OnSave.InvokeAsync((Account.AccountId, profile, credential));
        await OnClose.InvokeAsync();
    }

    private Task HandleClose() => OnClose.InvokeAsync();

    private static string FormatProvider(string provider)
        => provider.Contains("chatgpt", StringComparison.OrdinalIgnoreCase) || provider.Contains("openai", StringComparison.OrdinalIgnoreCase)
            ? "ChatGPT"
            : provider;
}
