@namespace FLASH_ROUTER.Components.Console.Components

<header class="app-topbar" role="banner">
    <div class="topbar-brand" aria-label="FLASH ROUTER">
        <img class="topbar-brand-mark" src="assets/brands/flash-router.png" alt="" width="34" height="34" />
        <div class="topbar-brand-copy">
            <strong>FLASH ROUTER</strong>
            <span>Account workspace</span>
        </div>
    </div>

    <div class="topbar-search-wrapper">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text"
               class="topbar-search-input"
               placeholder="Tìm kiếm account, email, nền tảng..."
               value="@SearchText"
               @oninput="HandleSearchInput"
               autocomplete="off"
               aria-label="Tìm kiếm toàn hệ thống" />
    </div>

    <div class="topbar-actions">
        <div class="runtime-status @(IsHealthy ? "is-healthy" : "is-warning")" role="status">
            <span class="runtime-status-dot"></span>
            <span>@StatusText</span>
        </div>

        <button type="button"
                class="action-icon-btn theme-toggle-btn"
                @onclick="ToggleThemeAsync"
                aria-label="@(CurrentTheme == "dark" ? "Chuyển sang chế độ Sáng" : "Chuyển sang chế độ Tối")"
                title="@(CurrentTheme == "dark" ? "Chuyển sang chế độ Sáng (Light Mode)" : "Chuyển sang chế độ Tối (Dark Mode)")">
            @if (CurrentTheme == "dark")
            {
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
            }
            else
            {
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            }
        </button>

    </div>
</header>

@code {
    [Parameter] public string SearchText { get; set; } = "";
    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }
    [Parameter] public string CurrentTheme { get; set; } = "dark";
    [Parameter] public EventCallback OnToggleTheme { get; set; }
    [Parameter] public bool IsHealthy { get; set; }
    [Parameter] public string StatusText { get; set; } = "Đang kiểm tra lưu trữ";

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? "";
        await OnSearchChanged.InvokeAsync(text);
    }

    private async Task ToggleThemeAsync()
    {
        await OnToggleTheme.InvokeAsync();
    }
}
