    }

    private async Task ExecuteBrowserLaunch(Guid accountId, string email)
    {
        _automationCts?.Cancel();
        _automationCts?.Dispose();
        _automationCts = new CancellationTokenSource();

        _automationDialogTitle = "Mở phiên ChatGPT được quản lý";
        _automationStage = "Khởi chạy";
        _automationStatusMessage = $"Đang mở phiên ChatGPT được quản lý cho {email}...";
        _automationTechnicalDetail = "Dùng profile riêng của account; không tự điền hoặc gửi password/TOTP.";
        _isAutomationRunning = true;
        _isAutomationSuccess = false;
        _isAutomationDialogOpen = true;
        StateHasChanged();

        try
        {
            var current = await BrowserSessionManager.GetStatusAsync(accountId, _automationCts.Token);
            BrowserAuthResult result;
            if (current.RuntimeState == AccountBrowserRuntimeState.Open
                && current.ActiveAttemptId is Guid activeAttemptId)
            {
                _automationDialogTitle = current.AuthenticationState == AuthenticationObservationStatus.AuthenticatedSessionConfirmed
                    ? "Kiểm tra phiên ChatGPT"
                    : "Tiếp tục đăng nhập ChatGPT";
                _automationStatusMessage = "Đang kiểm tra cửa sổ Chrome của tài khoản đang chọn...";
                _automationTechnicalDetail = "Giữ nguyên cửa sổ này để hoàn tất challenge. Ứng dụng chỉ quan sát lại trạng thái và không gửi lại mật khẩu hoặc mã xác minh.";
                StateHasChanged();
                result = await BrowserAuthOrchestrator.RefreshAsync(activeAttemptId, _automationCts.Token);
            }
            else
            {
                if (current.RuntimeState == AccountBrowserRuntimeState.Open)
                {
                    var closeResult = await BrowserSessionManager.CloseAsync(accountId, _automationCts.Token);
                    if (!closeResult.IsSuccess && closeResult.Status != "ALREADY_CLOSED")
                    {
                        _automationStage = "Không thể giải phóng profile";
                        _automationStatusMessage = closeResult.Message;
                        _automationTechnicalDetail = "Không thể giải phóng phiên trình duyệt. Đóng cửa sổ Chrome rồi thử lại.";
                        _isAutomationRunning = false;
                        _isAutomationSuccess = false;
                        return;
                    }
                }

                result = await BrowserAuthOrchestrator.StartAsync(accountId, _automationCts.Token);
            }

            _activeAutomationAttemptId = result.AttemptId;
            _automationStage = result.State switch
            {
                BrowserAuthState.BrowserSessionObserved when result.ObservationResult?.IdentityStatus == IdentityVerificationStatus.IdentityVerified => "Đã xác minh tài khoản",
                BrowserAuthState.BrowserSessionObserved => "Đã quan sát phiên; chưa xác minh tài khoản",
                BrowserAuthState.GuestLandingLoginAvailable or BrowserAuthState.EmailRequired
                    or BrowserAuthState.PasswordRequired or BrowserAuthState.MfaRequired
                    or BrowserAuthState.ExternalProviderRequired or BrowserAuthState.HumanActionRequired
                    or BrowserAuthState.WaitingForUser => "Cần hoàn tất đăng nhập trong Chrome",
                BrowserAuthState.ProfileInUse => "Profile đang được sử dụng",
                BrowserAuthState.Failed => "Không thể mở phiên",
                _ => FormatAutomationStage(result.State.ToString(), result.State)
            };
            _automationStatusMessage = result.Message;
            _automationTechnicalDetail = IsAuthenticatedProviderSession(result)
                ? "Đang đối chiếu email tài khoản rồi tự đọc gói và hạn mức."
                : "Nếu ChatGPT yêu cầu đăng nhập hoặc xác minh, hãy hoàn tất trực tiếp trong Chrome. Ứng dụng không gửi lại mật khẩu hay mã xác minh.";
            _isAutomationRunning = false;
            _isAutomationSuccess = IsConfirmedBrowserSession(result);
            _selectedBrowserRuntime = await BrowserSessionManager.GetStatusAsync(accountId, _automationCts.Token);
            await RefreshDataAsync();
            if (IsAuthenticatedProviderSession(result))
            {
                await CheckPlanAndQuotaAfterLoginAsync(accountId);
            }
        }
        catch (OperationCanceledException)
        {
            _automationStage = "Đã hủy";
            _automationStatusMessage = "Đã hủy thao tác mở phiên ChatGPT.";
            _automationTechnicalDetail = "Đã hủy thao tác mở trình duyệt.";
            _isAutomationRunning = false;
            _isAutomationSuccess = false;
        }
        catch
        {
            _automationStage = "Lỗi ngoại lệ";
            _automationStatusMessage = "Không thể mở phiên ChatGPT được quản lý cho account này.";
            _automationTechnicalDetail = "Không thể mở trình duyệt. Hãy thử lại.";
            _isAutomationRunning = false;
            _isAutomationSuccess = false;
        }

        StateHasChanged();
    }

    private async Task StartAccountObservationAsync(AccountDetailVm account, bool readUsageApi)
    {
        if (!IsChatGptLiveAccount(account))
        {
            _usageRefreshMessage = "Tính năng này hiện chỉ dùng cho tài khoản ChatGPT.";
            return;
        }

        _usageRefreshMessage = null;
        try
        {
            var sessionCheck = await BrowserSessionManager.CheckSessionAsync(account.AccountId);
            _selectedBrowserRuntime = sessionCheck.Snapshot;
        }
        catch
        {
            _selectedBrowserRuntime = await BrowserSessionManager.GetStatusAsync(account.AccountId);
        }

        var activeAttemptId = _selectedBrowserRuntime.ActiveAttemptId;
        var allowPendingObservation = _selectedBrowserRuntime.AuthenticationState == AuthenticationObservationStatus.PostLoginPending
            && activeAttemptId is not null;
        if (_selectedBrowserRuntime.AuthenticationState != AuthenticationObservationStatus.AuthenticatedSessionConfirmed
            && !allowPendingObservation)
        {
            _usageRefreshMessage = "Chưa xác nhận phiên trong profile Chrome riêng của tài khoản. Mở hoặc tiếp tục đăng nhập ở cửa sổ FLASH ROUTER đã mở rồi cập nhật lại; Chrome thường không dùng chung phiên.";
            return;
        }

        var providerId = ResolveLiveProviderId(account);
        var authorization = readUsageApi
            ? LiveProviderAuthorization.ReadOnlyExistingSessionUsageApi(
                account.AccountId,
                providerId,
                persistNonSecretObservations: true,
                DateTimeOffset.UtcNow,
                TimeSpan.FromMinutes(2),
                "user-requested-chatgpt-plan-and-usage",
                activeAttemptId,
                allowPendingObservation)
            : LiveProviderAuthorization.ReadOnlyExistingSession(
                account.AccountId,
                providerId,
                persistNonSecretObservations: false,
                DateTimeOffset.UtcNow,
                TimeSpan.FromMinutes(2),
                "user-requested-chatgpt-account-details",
                activeAttemptId,
                allowPendingObservation);
        var mode = readUsageApi
            ? LiveProviderCertificationMode.ExistingAuthenticatedSessionUsageApi
            : LiveProviderCertificationMode.ExistingAuthenticatedSessionOnly;

        await ExecuteAccountObservationAsync(account, authorization, mode);
    }

    private static bool IsChatGptLiveAccount(AccountDetailVm account)
        => account.Provider.Contains("chatgpt", StringComparison.OrdinalIgnoreCase)
            || account.Provider.Equals("openai", StringComparison.OrdinalIgnoreCase)
            || account.Provider.Equals("openai-chatgpt", StringComparison.OrdinalIgnoreCase);

    private static string ResolveLiveProviderId(AccountDetailVm account)
        => IsChatGptLiveAccount(account) ? "openai-chatgpt" : account.Provider;

    private async Task ExecuteAccountObservationAsync(
        AccountDetailVm account,
        LiveProviderAuthorization authorization,
        LiveProviderCertificationMode mode)
    {
        _automationCts?.Cancel();
        _automationCts?.Dispose();
        _automationCts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
        _automationDialogTitle = authorization.UseProviderApi ? "Cập nhật gói và hạn mức" : "Kiểm tra thông tin ChatGPT";
        _automationStage = "Đang kiểm tra";
        _automationStatusMessage = authorization.UseProviderApi
            ? "Đang xác minh phiên và đọc hạn mức từ ChatGPT..."
            : "Đang đọc thông tin tài khoản từ ChatGPT...";
        _automationTechnicalDetail = null;
        _isAutomationRunning = true;
        _isAutomationSuccess = false;
        _isAutomationDialogOpen = true;
        StateHasChanged();

        try
        {
            var result = await LiveProviderCertification.CertifyAsync(
                new LiveProviderCertificationRequest(
                    account.AccountId,
                    authorization.ProviderId,
                    authorization,
                    Mode: mode,
                    ObservationTimeout: TimeSpan.FromSeconds(45)),
                _automationCts.Token);
            _automationStage = result.IsSuccess ? "Hoàn tất" : "Chưa hoàn tất";
            _automationStatusMessage = FormatObservationMessage(result.Code, result.IsSuccess);
            _automationTechnicalDetail = null;
            _usageRefreshMessage = authorization.UseProviderApi ? _automationStatusMessage : _usageRefreshMessage;
            _selectedBrowserRuntime = result.Snapshot;
            _isAutomationSuccess = result.IsSuccess;
            await LoadAccountDetailAsync(account.AccountId);
            if (result.Observation is not null)
            {
                _selectedAccountObservation = result.Observation;
            }
        }
        catch (OperationCanceledException)
        {
            _automationStage = "Đã hủy";
            _automationStatusMessage = "Đã dừng việc kiểm tra.";
            _automationTechnicalDetail = null;
            _isAutomationSuccess = false;
        }
        catch
        {
            _automationStage = "Chưa hoàn tất";
            _automationStatusMessage = "Chưa đọc được thông tin từ phiên ChatGPT. Phiên đăng nhập vẫn được giữ; hãy xem nhật ký của tài khoản để biết nguyên nhân.";
            _automationTechnicalDetail = null;
            _isAutomationSuccess = false;
        }
        finally
        {
            _isAutomationRunning = false;
            StateHasChanged();
        }
    }

