    private async Task HandleUpdateAccount((Guid Id, AccountEditorVm Model, CredentialUpdateInput? Credential) args)
    {
        try
        {
            var res = await AccountCommand.UpdateAccountAsync(args.Id, args.Model);
            if (!res.IsSuccess)
            {
                ShowAutomationFailure("Không thể lưu thay đổi", res.Message ?? "Dữ liệu tài khoản chưa hợp lệ.");
                return;
            }

            if (args.Credential is not null)
            {
                var credentialResult = await CredentialPort.UpdateAsync(args.Id, args.Credential);
                if (!credentialResult.IsSuccess)
                {
                    var title = credentialResult.Status == "LEGACY_UNLOCK_REQUIRED"
                        ? "Credential cần thay thế"
                        : "Không thể cập nhật credential";
                    ShowAutomationFailure(title, credentialResult.Message);
                    return;
                }

                await RefreshDataAsync();
                await ExecuteLoginAgain(args.Id, args.Model.Email);
                return;
            }

            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating account: {ex.Message}");
        }
    }

