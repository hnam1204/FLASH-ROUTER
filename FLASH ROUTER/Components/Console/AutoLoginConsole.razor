    }

    private async Task ConfirmCopyAccount()
    {
        if (_copyConfirmationAccountId is not Guid accountId)
        {
            CancelCopyAccount();
            return;
        }

        try
        {
            var result = await AccountCopyPort.CopySavedCredentialsAsync(accountId, confirmed: true);
            if (!result.IsSuccess || string.IsNullOrEmpty(result.ClipboardText))
            {
                _copyFeedback = result.Message;
                return;
            }

            var clipboardText = result.ClipboardText;
            var copied = await JSRuntime.InvokeAsync<bool>("flashRouter.copyToClipboard", clipboardText);
            await AccountCopyPort.RecordClipboardOutcomeAsync(
                accountId,
                copied,
                copied ? null : "CLIPBOARD_WRITE_FAILED");
            if (!copied)
            {
                _copyFeedback = "Không thể ghi dữ liệu vào clipboard. Không có secret nào được hiển thị trong giao diện.";
                return;
            }

            CancelCopyAccount();
            await LoadAccountDetailAsync(accountId);
        }
        catch
        {
            await AccountCopyPort.RecordClipboardOutcomeAsync(accountId, succeeded: false, errorCode: "CLIPBOARD_WRITE_FAILED");
            _copyFeedback = "Không thể ghi dữ liệu vào clipboard. Không có secret nào được hiển thị trong giao diện.";
        }
    }

    private async Task HandleLiveActivityAsync(ActivityEventVm activityEvent)
    {
        if (_selectedAccountId is not Guid selectedAccountId || activityEvent.AccountId != selectedAccountId)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            if (_selectedAccountActivities.All(item => item.EventId != activityEvent.EventId))
            {
                _selectedAccountActivities = _selectedAccountActivities
                    .Append(activityEvent)
                    .OrderByDescending(item => item.Timestamp)
                    .ThenByDescending(item => item.EventId)
                    .Take(200)
                    .ToList();
            }

            // Intermediate automation events do not invalidate the inspector's
            // account/connection/usage projections. Reload only on durable state
            // transitions that can change visible session or identity semantics.
            if (RequiresAccountProjectionRefresh(activityEvent.EventType))
            {
                var detail = await AccountReader.GetAccountDetailAsync(selectedAccountId);
                if (detail is not null)
                {
                    _selectedAccountDetail = detail with
                    {
                        CredentialReferencePresent = _selectedAccountDetail?.CredentialReferencePresent ?? false
                    };
                }

                try
                {
                    _selectedBrowserRuntime = await BrowserSessionManager.GetStatusAsync(selectedAccountId);
                }
                catch
                {
                    // Keep the last runtime snapshot if a concurrent close occurs.
                }
            }

            StateHasChanged();
            if (_isConsoleLogOpen && _consoleLogAutoScroll)
            {
                await JSRuntime.InvokeVoidAsync("flashRouter.scrollConsole", "console-log-stream");
            }
        });
    }

    private static bool RequiresAccountProjectionRefresh(string eventType)
        => eventType is "AuthenticatedSessionConfirmed"
            or "IdentityVerified"
            or "IdentityUnverified"
            or "IdentityMismatch"
            or "CandidatePromotionCommitted"
            or "CandidatePromotionFailed"
            or "PostLoginPending"
            or "CandidateReadyForObservation"
            or "PendingCandidateLeaseExpired"
            or "BrowserSessionRegistrationReleased"
            or "PostLoginObservationTimedOut"
            or "AttemptFailed";

