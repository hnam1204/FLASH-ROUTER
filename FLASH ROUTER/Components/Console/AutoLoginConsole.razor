    private async Task ConfirmCopyAccount()
    {
        if (_copyConfirmationAccountId is not Guid accountId)
        {
            CancelCopyAccount();
            return;
        }

        try
        {
            var result = await AccountCopyPort.CopySavedCredentialsAsync(accountId, confirmed: true);
            if (!result.IsSuccess || string.IsNullOrEmpty(result.ClipboardText))
            {
                _copyFeedback = result.Message;
                return;
            }

            var clipboardText = result.ClipboardText;
            var copied = await JSRuntime.InvokeAsync<bool>("flashRouter.copyToClipboard", clipboardText);
            await AccountCopyPort.RecordClipboardOutcomeAsync(
                accountId,
                copied,
                copied ? null : "CLIPBOARD_WRITE_FAILED");
            if (!copied)
            {
                _copyFeedback = "Không thể ghi dữ liệu vào clipboard. Không có secret nào được hiển thị trong giao diện.";
                return;
            }

            CancelCopyAccount();
            await LoadAccountDetailAsync(accountId);
        }
        catch
        {
            await AccountCopyPort.RecordClipboardOutcomeAsync(accountId, succeeded: false, errorCode: "CLIPBOARD_WRITE_FAILED");
            _copyFeedback = "Không thể ghi dữ liệu vào clipboard. Không có secret nào được hiển thị trong giao diện.";
        }
    }

