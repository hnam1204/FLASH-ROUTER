        => item.EventType switch
        {
            "AttemptStarted" or "EphemeralAttemptStarted" => "Bắt đầu đăng nhập tài khoản",
            "CredentialStored" => "Đã lưu thông tin đăng nhập an toàn",
            "BrowserProfileSelected" => "Đã chọn hồ sơ trình duyệt",
            "ProfileLeaseAcquired" => "Đã chuẩn bị trình duyệt",
            "ChromeLaunchSucceeded" => "Đã mở Chromium thành công",
            "OfficialNavigationStarted" => "Đang truy cập trang đăng nhập chính thức",
            "OfficialNavigationSucceeded" or "OfficialChatGPTReached" => "Đã truy cập ChatGPT",
            "GuestLandingDetected" => "Đã nhận diện trang chưa đăng nhập",
            "LoginCtaActivated" => "Đã mở biểu mẫu đăng nhập",
            "EmailModalDetected" or "EmailFilled" => "Đã nhập địa chỉ email",
            "EmailContinued" => "Đã tiếp tục với email",
            "PasswordStepDetected" => "Đã chuyển đến bước mật khẩu",
            "PasswordSubmitted" => "Đã gửi mật khẩu",
            "MfaStepDetected" => "Trang web yêu cầu mã xác thực hai bước",
            "TotpSubmitted" => "Đã gửi mã xác thực hai bước",
            "PostLoginObservationStarted" => "Đang kiểm tra kết quả đăng nhập",
            "BrowserSessionObserved" => "Đã nhận diện dấu hiệu phiên đăng nhập",
            "AuthenticatedSessionConfirmed" => "Đã xác nhận phiên đăng nhập",
            "IdentityResolutionPending" => "Đang xác định thông tin tài khoản",
            "IdentityResolutionPartial" or "IdentityResolutionUnsupported" => "Chưa thể lấy thông tin tài khoản từ nguồn hiện có",
            "BrowserClosed" => "Đã đóng trình duyệt",
            "BrowserCrashed" or "BrowserDisconnected" => "Trình duyệt đã dừng bất thường",
            "AttemptCancelled" => "Quá trình đăng nhập đã bị hủy",
            "PostLoginObservationTimedOut" or "ObservationTimedOut" => "Không thể xác minh phiên trong thời gian cho phép",
            "CandidateReadyForPromotion" => "Hồ sơ đăng nhập mới đang chờ xác nhận thay thế",
            "CandidatePromotionCommitted" => "Đã ghi nhận hồ sơ trình duyệt mới",
            "CandidatePromotionFailed" => "Không thể ghi nhận hồ sơ trình duyệt mới",
            "AutoLoginCompleted" or "AuthenticationAttemptCompleted" => "Đã hoàn tất quy trình xác thực",
            _ when item.Severity.Equals("Error", StringComparison.OrdinalIgnoreCase) => "Quy trình gặp lỗi cần kiểm tra",
            _ => item.Summary
        };

    private static string FormatAuthenticationState(string? state)
        => state switch
        {
            "AuthenticatedSessionConfirmed" => "Đăng nhập thành công",
            "BrowserSessionObserved" => "Đã quan sát phiên",
            "LoginInProgress" => "Đang đăng nhập",
            "MfaRequired" => "Cần MFA",
            "WaitingForUser" => "Cần thao tác người dùng",
            _ => string.IsNullOrWhiteSpace(state) ? "Chưa xác minh" : state
        };

    private static string FormatSeverity(string severity)
        => severity.ToUpperInvariant() switch
        {
            "SUCCESS" or "PASS" => "PASS",
            "WARNING" or "WARN" => "WARN",
            "ERROR" => "ERROR",
            _ => "INFO"
        };

    private static string FormatProviderName(string provider)
    {
        if (provider.Contains("chatgpt", StringComparison.OrdinalIgnoreCase) || provider.Contains("openai", StringComparison.OrdinalIgnoreCase)) return "ChatGPT";
        if (provider.Contains("claude", StringComparison.OrdinalIgnoreCase) || provider.Contains("anthropic", StringComparison.OrdinalIgnoreCase)) return "Claude";
        if (provider.Contains("gemini", StringComparison.OrdinalIgnoreCase) || provider.Contains("google", StringComparison.OrdinalIgnoreCase)) return "Gemini";
        if (provider.Contains("perplexity", StringComparison.OrdinalIgnoreCase)) return "Perplexity";
        return string.IsNullOrWhiteSpace(provider) ? "Chưa rõ" : provider;
    }

