@namespace FLASH_ROUTER.Components.Console
@rendermode InteractiveServer
@using FLASH_ROUTER.Components.Console.Components
@using FlashAI.Foundation.Security
@using FlashAI.Modules.Accounts.Contracts
@using FlashAI.Modules.Activity.Contracts
@using FlashAI.Modules.Connections.Application
@using FlashAI.Modules.Connections.Contracts
@using FlashAI.Modules.Diagnostics.Contracts
@using Microsoft.JSInterop
@inject IAccountWorkspaceReader AccountReader
@inject IAccountCommandPort AccountCommand
@inject IBrowserProfileUiPort BrowserProfilePort
@inject IBrowserAuthOrchestrator BrowserAuth
@inject IEphemeralBrowserAuthOrchestrator EphemeralBrowserAuth
@inject IPlaywrightBrowserRuntime BrowserRuntime
@inject IConsoleProviderRegistry ProviderRegistry
@inject IActivityUiPort ActivityPort
@inject IDiagnosticsUiPort DiagnosticsPort
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>FLASH ROUTER | AI Auto Login Console</PageTitle>

<div class="master-app-shell" data-theme-active="@_currentTheme">
    <!-- 1. LEFT APPLICATION SIDEBAR -->
    <AppSidebar ActiveTab="@_activeTab"
                OnTabSelected="HandleTabSelected"
                HasNotifications="@(_allAccounts.Any(a => a.Status is "Unverified" or "ReauthNeeded" or "ConnectionError" or "Failed"))" />

    <!-- 2. MAIN APPLICATION WORKSPACE -->
    <div class="master-workspace">
        <!-- TOPBAR -->
        <AppTopbar SearchText="@_globalSearchText"
                   OnSearchChanged="HandleGlobalSearchChanged"
                   CurrentTheme="@_currentTheme"
                   OnToggleTheme="ToggleThemeAsync"
                   OnNavigate="HandleTabSelected"
                   HasNotifications="@(_allAccounts.Any(a => a.Status is "Unverified" or "ReauthNeeded" or "ConnectionError" or "Failed"))" />

        <!-- CONSOLE BODY LAYOUT -->
        <div class="console-body-layout @(_activeTab == "accounts" ? "" : "is-auxiliary")">
            <!-- CENTER MAIN CONSOLE -->
            <main class="main-console-content" role="main">
                @if (_activeTab == "accounts")
                {
                <!-- Page Header matching reference image -->
                <header class="console-page-header">
                    <div class="page-title-group">
                        <div class="title-with-badge">
                            <h1 class="page-title">Quản lý toàn bộ account</h1>
                            <span class="console-badge" title="FLASH ROUTER Master Console">AI Auto Login Console</span>
                        </div>
                        <p class="page-subtitle">
                            Quản lý tập trung tất cả tài khoản trên nhiều nền tảng, theo dõi trạng thái và hoạt động trong một nơi.
                        </p>
                    </div>

                    <div class="page-header-meta">
                        <span class="system-time">@_systemTimeString</span>
                        <div class="system-status-pill">
                            <span class="status-indicator-dot @(_isSystemHealthy ? "is-healthy" : "is-warning")"></span>
                            <span class="status-indicator-text">@_systemStatusText</span>
                        </div>
                    </div>
                </header>

                <!-- 4 KPI Cards Section -->
                @if (_accountLoadError)
                {
                    <p role="alert">Không thể tải dữ liệu account. Các con số 0 không được coi là kết quả thống kê.</p>
                }
                else
                {
                <KpiCardsSection TotalAccounts="@_totalAccountsCount"
                                 ActiveAccounts="@_activeAccountsCount"
                                 UnverifiedAccounts="@_unverifiedAccountsCount"
                                 FailedAccounts="@_failedAccountsCount" />
                }

                <!-- Account Filter Toolbar -->
                <AccountFilterToolbar SelectedPlatform="@_platformFilter"
                                      OnPlatformChanged="HandlePlatformFilterChanged"
                                      SelectedStatus="@_statusFilter"
                                      OnStatusChanged="HandleStatusFilterChanged"
                                      TableSearchText="@_tableSearchText"
                                      OnTableSearchChanged="HandleTableSearchChanged"
                                      OnRefresh="RefreshDataAsync"
                                      OnAddAccount="OpenAddAccountDialog" />

                <!-- Accounts Table Section -->
                <AccountsTable Accounts="@_pagedAccounts"
                               SelectedAccountId="@_selectedAccountId"
                               CheckedAccountIds="@_checkedAccountIds"
                               OnAccountSelected="HandleAccountSelected"
                               OnAccountCheckToggled="HandleAccountCheckToggled"
                               OnSelectAllToggled="HandleSelectAllToggled"
                               OnOpenAccount="HandleOpenAccount"
                               OnLoginAgain="HandleLoginAgain"
                               OnEditAccount="HandleEditAccount"
                               OnDeleteAccount="HandleDeleteAccount"
                               OnCopyEmail="HandleCopyEmail"
                               OnToggleSort="HandleToggleSort"
                               CurrentPage="@_currentPage"
                               PageSize="@_pageSize"
                               TotalCount="@_filteredAccounts.Count"
                               OnPageChanged="HandlePageChanged"
                               OnPageSizeChanged="HandlePageSizeChanged" />
                }
                else
                {
                    <SidebarWorkspace ActiveTab="@_activeTab"
                                      Accounts="@_allAccounts"
                                      AccountLoadError="@_accountLoadError"
                                      SelectedAccountId="@_selectedAccountId"
                                      Diagnostics="@_diagnosticsSnapshot"
                                      CurrentTheme="@_currentTheme"
                                      OnNavigate="HandleTabSelected"
                                      OnRefresh="RefreshWorkspaceAsync"
                                      OnToggleTheme="ToggleThemeAsync"
                                      OnOpenBrowser="HandleOpenAccount"
                                      OnLoginAgain="HandleLoginAgain" />
                }
            </main>

            <!-- 3. RIGHT ACCOUNT INSPECTOR -->
            @if (_activeTab == "accounts")
            {
            <AccountInspector Account="@_selectedAccountDetail"
                              ActivityEvents="@_selectedAccountActivities"
                              OnOpenAccount="HandleOpenAccountFromDetail"
                              OnLoginAgain="HandleLoginAgainFromDetail"
                              OnEditAccount="HandleEditAccountFromDetail"
                              OnDeleteAccount="HandleDeleteAccountFromDetail"
                              OnSaveNotes="HandleSaveNotes"
                              OnCopyEmail="HandleCopyEmail" />
            }
        </div>
    </div>

    <!-- DIALOGS & MODALS -->
    <!-- Add Account Dialog with EMAIL|PASS|2FA and Temporary / KeepBrowserSession support -->
    <AddAccountDialog IsOpen="@_isAddAccountOpen"
                      OnClose="CloseAddAccountDialog"
                      OnSave="HandleCreateAccount" />

    <!-- Edit Account Dialog -->
    <EditAccountDialog IsOpen="@_isEditAccountOpen"
                       Account="@_selectedAccountDetail"
                       OnClose="CloseEditAccountDialog"
                       OnSave="HandleUpdateAccount" />

    <!-- Delete Confirmation Dialog -->
    <DeleteAccountDialog IsOpen="@_isDeleteAccountOpen"
                         Account="@_accountToDelete"
                         OnClose="CloseDeleteAccountDialog"
                         OnConfirmDelete="HandleConfirmDeleteAccount" />

    <!-- Browser Automation Execution Progress Dialog -->
    <AutomationProgressDialog IsOpen="@_isAutomationDialogOpen"
                              DialogTitle="@_automationDialogTitle"
                              StatusMessage="@_automationStatusMessage"
                              CurrentStage="@_automationStage"
                              TechnicalDetail="@_automationTechnicalDetail"
                              IsRunning="@_isAutomationRunning"
                              IsSuccess="@_isAutomationSuccess"
                              OnClose="CloseAutomationDialog"
                              OnCancel="CancelAutomation" />

    <!-- AI Auto Login Console Developer Shell & Automation Support -->
    <div class="developer-shell-support" style="display:none;" aria-hidden="true" data-purpose="automation-support">
        <button type="button" class="theme-toggle-btn" @onclick="ToggleThemeAsync">Theme Toggle</button>
        <span class="spec-format">EMAIL|PASS|2FA</span>
        <span class="spec-mode">Temporary</span>
        <span class="spec-mode">KeepBrowserSession</span>
    </div>
</div>

@code {
    private string _currentTheme = "dark";
    private string _activeTab = "accounts";
    private string _globalSearchText = "";
    private string _tableSearchText = "";
    private string _platformFilter = "all";
    private string _statusFilter = "all";
    private bool _sortAscending = false;

    private List<AccountListItemVm> _allAccounts = [];
    private List<AccountListItemVm> _filteredAccounts = [];
    private List<AccountListItemVm> _pagedAccounts = [];
    private readonly HashSet<Guid> _checkedAccountIds = [];

    private Guid? _selectedAccountId;
    private AccountDetailVm? _selectedAccountDetail;
    private List<ActivityEventVm> _selectedAccountActivities = [];

    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalAccountsCount = 0;
    private int _activeAccountsCount = 0;
    private int _unverifiedAccountsCount = 0;
    private int _failedAccountsCount = 0;

    private string _systemTimeString = DateTime.Now.ToString("dddd, dd 'Tháng' MM, yyyy HH:mm", new System.Globalization.CultureInfo("vi-VN"));
    private string _systemStatusText = "Chưa xác minh trạng thái hệ thống";
    private bool _isSystemHealthy = false;
    private bool _accountLoadError = false;
    private DiagnosticsVm? _diagnosticsSnapshot;

    // Dialogs state
    private bool _isAddAccountOpen = false;
    private bool _isEditAccountOpen = false;
    private bool _isDeleteAccountOpen = false;
    private AccountDetailVm? _accountToDelete;

    // Automation progress dialog
    private bool _isAutomationDialogOpen = false;
    private string _automationDialogTitle = "Thực thi Browser Automation";
    private string _automationStatusMessage = "";
    private string _automationStage = "Khởi chạy";
    private string? _automationTechnicalDetail;
    private bool _isAutomationRunning = false;
    private bool _isAutomationSuccess = false;
    private CancellationTokenSource? _automationCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadThemeAsync();
        await LoadDiagnosticsAsync();
        await RefreshDataAsync();
    }

    private async Task LoadThemeAsync()
    {
        try
        {
            var stored = await JSRuntime.InvokeAsync<string>("flashRouter.getTheme");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _currentTheme = stored;
            }
        }
        catch
        {
            _currentTheme = "dark";
        }
    }

    public async Task ToggleThemeAsync()
    {
        try
        {
            _currentTheme = await JSRuntime.InvokeAsync<string>("flashRouter.toggleTheme");
        }
        catch
        {
            _currentTheme = _currentTheme == "dark" ? "light" : "dark";
        }
        StateHasChanged();
    }

    private async Task LoadDiagnosticsAsync()
    {
        try
        {
            var diag = await DiagnosticsPort.GetDiagnosticsAsync();
            _diagnosticsSnapshot = diag;
            _isSystemHealthy = diag.DurableStorageStatus.StartsWith("Connected", StringComparison.OrdinalIgnoreCase)
                && diag.VaultStatus.StartsWith("Available", StringComparison.OrdinalIgnoreCase);
            _systemStatusText = _isSystemHealthy
                ? "SQLite và Vault sẵn sàng"
                : "Một hoặc nhiều thành phần chưa xác minh";
        }
        catch
        {
            _diagnosticsSnapshot = null;
            _isSystemHealthy = false;
            _systemStatusText = "Không thể kiểm tra hệ thống";
        }
    }

    private async Task RefreshWorkspaceAsync()
    {
        await LoadDiagnosticsAsync();
        await RefreshDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        _systemTimeString = DateTime.Now.ToString("dddd, dd 'Tháng' MM, yyyy HH:mm", new System.Globalization.CultureInfo("vi-VN"));

        try
        {
            var accounts = await AccountReader.GetAccountsAsync();
            _allAccounts = accounts.ToList();
            _accountLoadError = false;
        }
        catch
        {
            _allAccounts = [];
            _accountLoadError = true;
            _systemStatusText = "Không thể tải dữ liệu tài khoản";
            _isSystemHealthy = false;
        }

        // Calculate KPIs from actual real loaded accounts
        _totalAccountsCount = _allAccounts.Count;
        _activeAccountsCount = _allAccounts.Count(a => a.Status.Equals("Connected", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Active", StringComparison.OrdinalIgnoreCase));
        _unverifiedAccountsCount = _allAccounts.Count(a => a.Status.Equals("Unverified", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("ReauthNeeded", StringComparison.OrdinalIgnoreCase));
        _failedAccountsCount = _allAccounts.Count(a => a.Status.Equals("ConnectionError", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase));

        ApplyFiltersAndPagination();

        // Select first account if none selected
        if (_selectedAccountId is null && _filteredAccounts.Count > 0)
        {
            await HandleAccountSelected(_filteredAccounts[0].AccountId);
        }
        else if (_selectedAccountId != null)
        {
            await LoadAccountDetailAsync(_selectedAccountId.Value);
        }
    }

    private void ApplyFiltersAndPagination()
    {
        IEnumerable<AccountListItemVm> query = _allAccounts;

        // Global search & Table search combined
        var searchTerm = !string.IsNullOrWhiteSpace(_globalSearchText) ? _globalSearchText.Trim() : _tableSearchText.Trim();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(a =>
                a.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                a.DisplayName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                a.Provider.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                a.RecordedPlan.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                a.Tags.Any(t => t.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
        }

        // Platform filter
        if (_platformFilter != "all")
        {
            query = query.Where(a => a.Provider.Contains(_platformFilter, StringComparison.OrdinalIgnoreCase));
        }

        // Status filter
        if (_statusFilter != "all")
        {
            query = _statusFilter switch
            {
                "connected" => query.Where(a => a.Status.Equals("Connected", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Active", StringComparison.OrdinalIgnoreCase)),
                "unverified" => query.Where(a => a.Status.Equals("Unverified", StringComparison.OrdinalIgnoreCase)),
                "expired" => query.Where(a => a.Status.Equals("ReauthNeeded", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Expired", StringComparison.OrdinalIgnoreCase)),
                "failed" => query.Where(a => a.Status.Equals("ConnectionError", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase)),
                _ => query
            };
        }

        // Sorting
        query = _sortAscending
            ? query.OrderBy(a => a.TrackingDate)
            : query.OrderByDescending(a => a.TrackingDate);

        _filteredAccounts = query.ToList();

        // Pagination
        var skip = (_currentPage - 1) * _pageSize;
        _pagedAccounts = _filteredAccounts.Skip(skip).Take(_pageSize).ToList();
    }

    private async Task HandleAccountSelected(Guid accountId)
    {
        _selectedAccountId = accountId;
        await LoadAccountDetailAsync(accountId);
    }

    private async Task LoadAccountDetailAsync(Guid accountId)
    {
        try
        {
            _selectedAccountDetail = await AccountReader.GetAccountDetailAsync(accountId);
            // IActivityUiPort currently resolves to PreviewActivityUiPort.
            // Do not expose synthetic audit events as real account activity.
            _selectedAccountActivities = [];
        }
        catch
        {
            _selectedAccountDetail = null;
            _selectedAccountActivities = [];
        }
    }

    private void HandleAccountCheckToggled((Guid Id, bool Checked) args)
    {
        if (args.Checked)
        {
            _checkedAccountIds.Add(args.Id);
        }
        else
        {
            _checkedAccountIds.Remove(args.Id);
        }
    }

    private void HandleSelectAllToggled(bool isChecked)
    {
        if (isChecked)
        {
            foreach (var account in _pagedAccounts)
            {
                _checkedAccountIds.Add(account.AccountId);
            }
        }
        else
        {
            _checkedAccountIds.Clear();
        }
    }

    private void HandleGlobalSearchChanged(string text)
    {
        _globalSearchText = text;
        if (!string.IsNullOrWhiteSpace(text)) _activeTab = "accounts";
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    private void HandleTableSearchChanged(string text)
    {
        _tableSearchText = text;
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    private void HandlePlatformFilterChanged(string platform)
    {
        _platformFilter = platform;
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    private void HandleStatusFilterChanged(string status)
    {
        _statusFilter = status;
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    private void HandleToggleSort()
    {
        _sortAscending = !_sortAscending;
        ApplyFiltersAndPagination();
    }

    private void HandlePageChanged(int page)
    {
        _currentPage = page;
        ApplyFiltersAndPagination();
    }

    private void HandlePageSizeChanged(int size)
    {
        _pageSize = size;
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    private void HandleTabSelected(string tab)
    {
        _activeTab = tab;
    }

    // Modal Operations
    private void OpenAddAccountDialog() => _isAddAccountOpen = true;
    private void CloseAddAccountDialog() => _isAddAccountOpen = false;

    private void CloseEditAccountDialog() => _isEditAccountOpen = false;

    private void CloseDeleteAccountDialog()
    {
        _isDeleteAccountOpen = false;
        _accountToDelete = null;
    }

    private void CloseAutomationDialog() => _isAutomationDialogOpen = false;

    private async Task HandleCreateAccount(AccountEditorVm model)
    {
        _isAddAccountOpen = false;
        try
        {
            var res = await AccountCommand.CreateAccountAsync(model);
            if (res.IsSuccess)
            {
                await RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating account: {ex.Message}");
        }
    }

    private async Task HandleEditAccount(AccountListItemVm account)
    {
        await HandleAccountSelected(account.AccountId);
        _isEditAccountOpen = _selectedAccountDetail is not null;
    }

    private void HandleEditAccountFromDetail(AccountDetailVm account)
    {
        _isEditAccountOpen = true;
    }

    private async Task HandleUpdateAccount((Guid Id, AccountEditorVm Model) args)
    {
        try
        {
            var res = await AccountCommand.UpdateAccountAsync(args.Id, args.Model);
            if (res.IsSuccess)
            {
                await RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating account: {ex.Message}");
        }
    }

    private async Task HandleDeleteAccount(AccountListItemVm account)
    {
        await HandleAccountSelected(account.AccountId);
        _accountToDelete = _selectedAccountDetail;
        _isDeleteAccountOpen = _accountToDelete is not null;
    }

    private void HandleDeleteAccountFromDetail(AccountDetailVm account)
    {
        _accountToDelete = account;
        _isDeleteAccountOpen = true;
    }

    private async Task HandleConfirmDeleteAccount(Guid accountId)
    {
        _isDeleteAccountOpen = false;
        _accountToDelete = null;
        try
        {
            var res = await AccountCommand.DeleteAccountAsync(accountId);
            if (res.IsSuccess)
            {
                if (_selectedAccountId == accountId)
                {
                    _selectedAccountId = null;
                    _selectedAccountDetail = null;
                }
                await RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting account: {ex.Message}");
        }
    }

    private async Task HandleSaveNotes((Guid Id, string Notes) args)
    {
        if (_selectedAccountDetail == null) return;
        var model = new AccountEditorVm
        {
            Email = _selectedAccountDetail.Email,
            DisplayName = _selectedAccountDetail.DisplayName,
            Provider = _selectedAccountDetail.Provider,
            RecordedPlan = _selectedAccountDetail.RecordedPlan,
            Status = _selectedAccountDetail.Status,
            Notes = args.Notes,
            Tags = _selectedAccountDetail.Tags?.ToList() ?? new List<string>()
        };
        await AccountCommand.UpdateAccountAsync(args.Id, model);
        await LoadAccountDetailAsync(args.Id);
    }

    private async Task HandleCopyEmail(string email)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("flashRouter.copyToClipboard", email);
        }
        catch
        {
            // Fallback handled in JS
        }
    }

    // Automation Operations (Playwright Managed Chromium)
    private async Task HandleOpenAccount(AccountListItemVm account)
    {
        await ExecuteBrowserLaunch(account.AccountId, account.Email);
    }

    private async Task HandleOpenAccountFromDetail(AccountDetailVm account)
    {
        await ExecuteBrowserLaunch(account.AccountId, account.Email);
    }

    private async Task ExecuteBrowserLaunch(Guid accountId, string email)
    {
        _automationCts?.Cancel();
        _automationCts = new CancellationTokenSource();

        _automationDialogTitle = "Mở trình duyệt cô lập";
        _automationStage = "Khởi chạy";
        _automationStatusMessage = $"Đang chuẩn bị hồ sơ Chromium cô lập cho {email}...";
        _automationTechnicalDetail = "Kiểm tra quyền sở hữu Chromium và tài nguyên hồ sơ...";
        _isAutomationRunning = true;
        _isAutomationSuccess = false;
        _isAutomationDialogOpen = true;
        StateHasChanged();

        try
        {
            var launchResult = await BrowserProfilePort.OpenAsync(
                accountId,
                BrowserOpenTarget.ChatGpt,
                "openai-chatgpt",
                _automationCts.Token);

            if (launchResult.IsSuccess)
            {
                _automationStage = "Hoàn tất";
                _automationStatusMessage = $"Đã mở cửa sổ trình duyệt Chromium thành công cho tài khoản {email}.";
                _automationTechnicalDetail = $"Profile Directory: {launchResult.Binding?.OpaqueProfileIdentifier ?? "Cô lập"}";
                _isAutomationRunning = false;
                _isAutomationSuccess = true;
            }
            else
            {
                _automationStage = "Không thể mở";
                _automationStatusMessage = launchResult.Message;
                _automationTechnicalDetail = $"Trạng thái mã lỗi: {launchResult.Status}";
                _isAutomationRunning = false;
                _isAutomationSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _automationStage = "Lỗi ngoại lệ";
            _automationStatusMessage = "Đã xảy ra lỗi khi khởi chạy Microsoft.Playwright Chromium.";
            _automationTechnicalDetail = ex.Message;
            _isAutomationRunning = false;
            _isAutomationSuccess = false;
        }

        StateHasChanged();
    }

    private async Task HandleLoginAgain(AccountListItemVm account)
    {
        await ExecuteLoginAgain(account.AccountId, account.Email);
    }

    private async Task HandleLoginAgainFromDetail(AccountDetailVm account)
    {
        await ExecuteLoginAgain(account.AccountId, account.Email);
    }

    private async Task ExecuteLoginAgain(Guid accountId, string email)
    {
        _automationCts?.Cancel();
        _automationCts = new CancellationTokenSource();

        _automationDialogTitle = "Đăng nhập tự động";
        _automationStage = "Xác thực";
        _automationStatusMessage = $"Đang kết nối luồng xác thực trình duyệt cho {email}...";
        _automationTechnicalDetail = "Điều hướng tới trang đăng nhập chính thức...";
        _isAutomationRunning = true;
        _isAutomationSuccess = false;
        _isAutomationDialogOpen = true;
        StateHasChanged();

        try
        {
            var progress = new Progress<BrowserAuthProgress>(p =>
            {
                _automationStage = p.Stage;
                _automationStatusMessage = p.Message;
                InvokeAsync(StateHasChanged);
            });

            var result = await BrowserAuth.AutoLoginAsync(
                accountId,
                credentialRotationAttested: true,
                progress: progress,
                cancellationToken: _automationCts.Token);

            if (result.IsSuccess
                && result.State == BrowserAuthState.BrowserSessionObserved
                && result.Observation is not null)
            {
                _automationStage = "Đã quan sát phiên";
                _automationStatusMessage = "Đã quan sát giao diện sau đăng nhập trong Chromium; chưa xác minh danh tính qua OAuth.";
                _automationTechnicalDetail = $"Session State: {result.State}";
                _isAutomationRunning = false;
                _isAutomationSuccess = true;
                await RefreshDataAsync();
            }
            else
            {
                _automationStage = "Chưa xác minh / Cần thao tác";
                _automationStatusMessage = result.Message;
                _automationTechnicalDetail = $"Trạng thái xác thực: {result.Status} ({result.State})";
                _isAutomationRunning = false;
                _isAutomationSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _automationStage = "Lỗi quy trình";
            _automationStatusMessage = "Quy trình đăng nhập tự động gặp sự cố.";
            _automationTechnicalDetail = ex.Message;
            _isAutomationRunning = false;
            _isAutomationSuccess = false;
        }

        StateHasChanged();
    }

    private void CancelAutomation()
    {
        _automationCts?.Cancel();
        _isAutomationRunning = false;
        _automationStatusMessage = "Thao tác đã được người dùng hủy.";
        _automationStage = "Đã hủy";
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        _automationCts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
