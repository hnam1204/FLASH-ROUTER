        {
            "CHATGPT_USAGE_API_OBSERVED" => "Đã cập nhật gói và hạn mức từ ChatGPT.",
            "ACCOUNT_DATA_OBSERVED" => "Đã cập nhật thông tin tài khoản từ ChatGPT.",
            "IDENTITY_EMAIL_MISMATCH" => "Tài khoản đang mở không khớp tài khoản được chọn. Dữ liệu chưa được sử dụng.",
            "IDENTITY_EMAIL_UNAVAILABLE" or "IDENTITY_EVIDENCE_INSUFFICIENT" => "Chưa xác minh được tài khoản đang mở. Hoàn tất đăng nhập rồi thử lại.",
            "IDENTITY_UNCONFIRMED" or "IDENTITY_EMAIL_NOT_EXPOSED" => "Phiên đang đăng nhập, nhưng chưa đọc được email để đối chiếu tài khoản. Phiên hiện tại vẫn được giữ.",
            "ACCOUNT_OBSERVATION_FAILED" => "Phiên đăng nhập vẫn được giữ, nhưng chưa đọc được thông tin tài khoản. Xem nhật ký tài khoản để biết nguyên nhân.",
            "ACCOUNT_SETTINGS_UNAVAILABLE" => "Đã đăng nhập nhưng chưa thể mở mục Tài khoản trong ChatGPT. Mở mục Tài khoản trong cùng cửa sổ rồi thử lại.",
            "USAGE_API_UNAUTHORIZED" or "SESSION_NOT_CONFIRMED" => "Profile Chrome riêng của tài khoản chưa có phiên đăng nhập hợp lệ. Mở hoặc tiếp tục đăng nhập trong cửa sổ FLASH ROUTER đã mở rồi cập nhật lại; Chrome thường không dùng chung phiên.",
            "USAGE_API_FORBIDDEN" => "ChatGPT hiện chưa cho phép đọc hạn mức của phiên này.",
            "USAGE_API_RATE_LIMITED" => "ChatGPT đang giới hạn yêu cầu. Hãy thử lại sau.",
            "USAGE_API_SCHEMA_UNSUPPORTED" => "ChatGPT chưa trả về định dạng hạn mức được hỗ trợ. Không có số liệu ước tính được hiển thị.",
            "BROWSER_NOT_OPEN" => "Mở phiên ChatGPT và đăng nhập trước khi cập nhật.",
            "BROWSER_PROFILE_BINDING_MISSING" or "PROVIDER_SCOPE_MISMATCH" or "ATTEMPT_SCOPE_MISMATCH" => "Phiên trình duyệt không khớp tài khoản đang chọn. Hãy đăng nhập lại bằng tài khoản này.",
            "CERTIFICATION_TIMEOUT" => "ChatGPT mất quá nhiều thời gian để tải thông tin tài khoản. Giữ cửa sổ đăng nhập mở rồi thử lại.",
            _ when isSuccess => "Đã cập nhật thông tin ChatGPT.",
            _ => "Chưa lấy được dữ liệu thật từ ChatGPT. Hoàn tất đăng nhập rồi thử lại."
        };

    private Task HandleCloseBrowserFromDetail(AccountDetailVm account)
        => ExecuteBrowserOperationAsync(account.AccountId, "Đóng trình duyệt", BrowserSessionManager.CloseAsync);

    private async Task ExecuteBrowserOperationAsync(
        Guid accountId,
        string operation,
        Func<Guid, CancellationToken, Task<BrowserOperationResult>> action)
    {
        _automationDialogTitle = operation;
        _automationStage = "Đang xử lý";
        _automationStatusMessage = operation + " cho account đang chọn...";
        _automationTechnicalDetail = "Thao tác chỉ áp dụng cho tài khoản đang chọn.";
        _isAutomationRunning = true;
        _isAutomationSuccess = false;
        _isAutomationDialogOpen = true;
        StateHasChanged();
        try
        {
            var result = await action(accountId, CancellationToken.None);
            _automationStage = result.IsSuccess ? "Hoàn tất" : "Chưa hoàn tất";
            _automationStatusMessage = result.Message;
            _automationTechnicalDetail = result.IsSuccess
                ? "Thao tác đã hoàn tất cho tài khoản đang chọn."
                : "Thao tác chưa hoàn tất. Hãy kiểm tra phiên Chrome của tài khoản.";
            _isAutomationSuccess = result.IsSuccess;
            _selectedBrowserRuntime = result.Snapshot;
            await RefreshDataAsync();
        }
        catch
        {
            _automationStage = "Lỗi thao tác";
            _automationStatusMessage = "Không thể hoàn tất thao tác browser của account này.";
            _automationTechnicalDetail = "Không thể hoàn tất thao tác. Hãy kiểm tra phiên Chrome của tài khoản.";
        }
        finally
        {
            _isAutomationRunning = false;
            StateHasChanged();
        }
    }

    private async Task HandleLoginAgain(AccountListItemVm account)
    {
        await ExecuteLoginAgain(account.AccountId, account.Email);
    }

    private async Task HandleLoginAgainFromDetail(AccountDetailVm account)
    {
        await ExecuteLoginAgain(account.AccountId, account.Email);
    }

    private async Task ExecuteLoginAgain(Guid accountId, string email)
    {
        _automationCts?.Cancel();
        _automationCts?.Dispose();
        _automationCts = new CancellationTokenSource();
        _activeAutomationAttemptId = null;

        _automationDialogTitle = "Đăng nhập lại bằng profile mới";
        _automationStage = "Đang chuẩn bị trình duyệt";
        _automationStatusMessage = $"Đang đóng phiên browser cũ và chuẩn bị profile Chromium mới cho {email}...";
        _automationTechnicalDetail = "Thông tin đăng nhập được lấy từ kho bảo mật; hồ sơ trình duyệt trước vẫn được giữ lại.";
        _isAutomationRunning = true;
        _isAutomationSuccess = false;
        _isAutomationDialogOpen = true;
        StateHasChanged();

        try
        {
            await BrowserSessionManager.CloseAsync(accountId, _automationCts.Token);
            var progress = new Progress<BrowserAuthProgress>(p =>
            {
                if (p.AttemptId is Guid attemptId)
                {
                    if (_activeAutomationAttemptId is Guid active && active != attemptId)
                    {
                        return;
                    }

                    _activeAutomationAttemptId = attemptId;
                }

                _automationStage = FormatAutomationStage(p.Stage, p.State);
                _automationStatusMessage = p.Message;
                if (p.IsTerminal)
                {
                    _isAutomationRunning = false;
                    // A page-state observation is not enough to mark identity verified.
                    // The final result carries the independent account identity evidence.
                    _isAutomationSuccess = false;
                }

                _ = InvokeAsync(StateHasChanged);
            });

            var result = await CleanBrowserRelogin.ExecuteAsync(
                accountId,
                progress: progress,
                cancellationToken: _automationCts.Token);

            if (IsAuthenticatedProviderSession(result))
            {
                var identityVerified = IsConfirmedBrowserSession(result);
                _automationStage = identityVerified ? "Đã xác minh tài khoản" : "Đang kiểm tra tài khoản";
                _automationStatusMessage = result.Message;
                _automationTechnicalDetail = result.CandidateProfile is null
                    ? "Đang đọc thông tin gói và hạn mức từ phiên vừa đăng nhập."
                    : "Đang đối chiếu tài khoản trong phiên mới trước khi lưu dữ liệu.";
                _isAutomationRunning = false;
                _isAutomationSuccess = identityVerified;
                await RefreshDataAsync();
                await CheckPlanAndQuotaAfterLoginAsync(accountId);
            }
            else if (result.State == BrowserAuthState.PostLoginPending)
            {
                _automationStage = "Đang chờ provider";
                _automationStatusMessage = result.Message;
                _automationTechnicalDetail = "ChatGPT đang chờ xác minh trong Chrome. Ứng dụng không gửi lại mã xác minh.";
                _isAutomationRunning = false;
                _isAutomationSuccess = false;
                await RefreshDataAsync();
            }
            else
            {
                _automationStage = FormatAutomationStage(result.State.ToString(), result.State);
                _automationStatusMessage = result.Message;
                _selectedBrowserRuntime = await BrowserSessionManager.GetStatusAsync(accountId, _automationCts.Token);
                var retainedAttempt = result.AttemptId is Guid attemptId
                    && _selectedBrowserRuntime.ActiveAttemptId == attemptId
                    && _selectedBrowserRuntime.RuntimeState == AccountBrowserRuntimeState.Open;
                _automationTechnicalDetail = retainedAttempt
                    ? "Cửa sổ Chrome của profile mới vẫn được giữ. Hoàn tất bước đang hiển thị trong cửa sổ đó, rồi bấm “Tiếp tục đăng nhập” để kiểm tra lại; không gửi lại mật khẩu hay mã xác minh."
                    : result.Status == "INVALID_CREDENTIALS_BROWSER_CLOSED"
                        ? "Chrome đã đóng sau hơn năm lần nhập sai. Kiểm tra lại thông tin tài khoản trước khi bắt đầu luồng đăng nhập mới."
                        : "Phiên đăng nhập không còn mở. Nếu ChatGPT đang giới hạn yêu cầu, chờ hết giới hạn rồi bắt đầu lại; ứng dụng không tự gửi lại thông tin đăng nhập. ";
                _isAutomationRunning = false;
                _isAutomationSuccess = false;
                await RefreshDataAsync();
            }
        }
        catch (Exception)
        {
            _automationStage = "Lỗi quy trình";
            _automationStatusMessage = "Quy trình đăng nhập tự động gặp sự cố.";
            _automationTechnicalDetail = "Đã xảy ra lỗi trong khi đăng nhập. Hãy kiểm tra thông báo trạng thái rồi thử lại.";
            _isAutomationRunning = false;
            _isAutomationSuccess = false;
        }

        StateHasChanged();
    }

    private async Task CheckPlanAndQuotaAfterLoginAsync(Guid accountId)
    {
        if (_selectedAccountId != accountId)
        {
            return;
        }

        await LoadAccountDetailAsync(accountId);
        if (_selectedAccountDetail is { } account && account.AccountId == accountId)
        {
            await StartAccountObservationAsync(account, readUsageApi: true);
        }
    }

    private void CancelAutomation()
    {
        _automationCts?.Cancel();
        _automationStatusMessage = "Đang gửi yêu cầu hủy tới quy trình browser...";
        _automationStage = "Đang hủy";
        StateHasChanged();
    }

    private static bool IsConfirmedBrowserSession(BrowserAuthResult result)
        => result.IsSuccess
            && result.State == BrowserAuthState.BrowserSessionObserved
            && result.ObservationResult?.Status == AuthenticationObservationStatus.AuthenticatedSessionConfirmed
            && result.ObservationResult.IdentityStatus == IdentityVerificationStatus.IdentityVerified;

    private static bool IsAuthenticatedProviderSession(BrowserAuthResult result)
        => result.State == BrowserAuthState.BrowserSessionObserved
            && result.ObservationResult?.Status == AuthenticationObservationStatus.AuthenticatedSessionConfirmed;

    private static string FormatAutomationStage(string stage, BrowserAuthState state)
        => stage switch
        {
            "ValidatingInput" => "Đang chuẩn bị trình duyệt",
            "BrowserStarted" or "OpeningBrowser" => "Đang mở Chromium",
            "OpeningLogin" or "Navigating" => "Đang truy cập trang đăng nhập",
            "FillingEmail" => "Đang nhập email",
            "FillingPassword" => "Đang xác thực mật khẩu",
            "FillingTotp" or "SubmittingTotp" => "Đang gửi mã xác thực hai bước",
            "ObservingPostLogin" or "CheckingAuthenticatedSession" => "Đang kiểm tra kết quả đăng nhập",
            "PostLoginPending" => "Đang chờ provider hoàn tất phiên",
            "ConfirmingBrowserSession" => "Đã xác nhận phiên đăng nhập",
            "WaitingForUser" => "Cần xác minh thêm",
            "TimedOut" => "Không thể xác minh trong thời gian cho phép",
            "Cancelled" => "Đã hủy",
            _ when state == BrowserAuthState.BrowserSessionObserved => "Đã quan sát phiên; chưa xác minh tài khoản",
            _ when state == BrowserAuthState.TimedOut => "Không thể xác minh trong thời gian cho phép",
            _ when state == BrowserAuthState.Cancelled => "Đã hủy",
            _ => stage
        };

    public ValueTask DisposeAsync()
    {
        _automationCts?.Dispose();
        _activitySubscription?.Dispose();
        return ValueTask.CompletedTask;
    }
}
