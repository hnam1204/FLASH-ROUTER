    private async Task ExecuteLoginAgain(Guid accountId, string email)
    {
        _automationCts?.Cancel();
        _automationCts?.Dispose();
        _automationCts = new CancellationTokenSource();
        _activeAutomationAttemptId = null;

        _automationDialogTitle = "Đăng nhập lại bằng profile mới";
        _automationStage = "Đang chuẩn bị trình duyệt";
        _automationStatusMessage = $"Đang đóng phiên browser cũ và chuẩn bị profile Chromium mới cho {email}...";
        _automationTechnicalDetail = "Credential sẽ được đọc từ Vault; profile cũ không bị xóa.";
        _isAutomationRunning = true;
        _isAutomationSuccess = false;
        _isAutomationDialogOpen = true;
        StateHasChanged();

        try
        {
            await BrowserSessionManager.CloseAsync(accountId, _automationCts.Token);
            var progress = new Progress<BrowserAuthProgress>(p =>
            {
                if (p.AttemptId is Guid attemptId)
                {
                    if (_activeAutomationAttemptId is Guid active && active != attemptId)
                    {
                        return;
                    }

                    _activeAutomationAttemptId = attemptId;
                }

                _automationStage = FormatAutomationStage(p.Stage, p.State);
                _automationStatusMessage = p.Message;
                if (p.IsTerminal)
                {
                    _isAutomationRunning = false;
                    _isAutomationSuccess = p.State == BrowserAuthState.BrowserSessionObserved;
                }

                _ = InvokeAsync(StateHasChanged);
            });

            var result = await CleanBrowserRelogin.ExecuteAsync(
                accountId,
                progress: progress,
                cancellationToken: _automationCts.Token);

            if (result.IsSuccess)
            {
                _automationStage = "Thành công";
                _automationStatusMessage = result.Message;
                _automationTechnicalDetail = result.CandidateProfile is null
                    ? $"Trạng thái xác thực: {result.State}"
                    : "Profile mới được giữ theo chính sách candidate; profile cũ vẫn còn nguyên.";
                _isAutomationRunning = false;
                _isAutomationSuccess = true;
                await RefreshDataAsync();
            }
            else
            {
                _automationStage = FormatAutomationStage(result.State.ToString(), result.State);
                _automationStatusMessage = result.Message;
                _automationTechnicalDetail = $"Mã an toàn: {result.Status}; profile cũ được giữ nguyên.";
                _isAutomationRunning = false;
                _isAutomationSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _automationStage = "Lỗi quy trình";
            _automationStatusMessage = "Quy trình đăng nhập tự động gặp sự cố.";
            _automationTechnicalDetail = ex.Message;
            _isAutomationRunning = false;
            _isAutomationSuccess = false;
        }

        StateHasChanged();
    }

    private void CancelAutomation()
    {
        _automationCts?.Cancel();
        _automationStatusMessage = "Đang gửi yêu cầu hủy tới quy trình browser...";
        _automationStage = "Đang hủy";
        StateHasChanged();
    }

    private static string FormatAutomationStage(string stage, BrowserAuthState state)
        => stage switch
        {
            "ValidatingInput" => "Đang chuẩn bị trình duyệt",
            "BrowserStarted" or "OpeningBrowser" => "Đang mở Chromium",
            "OpeningLogin" or "Navigating" => "Đang truy cập trang đăng nhập",
            "FillingEmail" => "Đang nhập email",
            "FillingPassword" => "Đang xác thực mật khẩu",
            "FillingTotp" or "SubmittingTotp" => "Đang gửi mã xác thực hai bước",
            "ObservingPostLogin" or "CheckingAuthenticatedSession" => "Đang kiểm tra kết quả đăng nhập",
            "ConfirmingBrowserSession" => "Đã xác nhận phiên đăng nhập",
            "WaitingForUser" => "Cần xác minh thêm",
            "TimedOut" => "Không thể xác minh trong thời gian cho phép",
            "Cancelled" => "Đã hủy",
            _ when state == BrowserAuthState.BrowserSessionObserved => "Đã hoàn tất",
            _ when state == BrowserAuthState.TimedOut => "Không thể xác minh trong thời gian cho phép",
            _ when state == BrowserAuthState.Cancelled => "Đã hủy",
            _ => stage
        };

    public ValueTask DisposeAsync()
    {
        _automationCts?.Dispose();
        _activitySubscription?.Dispose();
        return ValueTask.CompletedTask;
    }
