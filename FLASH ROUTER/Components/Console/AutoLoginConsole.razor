    private static string FormatAttemptId(Guid? attemptId)
        => attemptId is Guid value ? value.ToString("N")[..12] : "Chưa có";

    private string BuildConsoleLogLine(ActivityEventVm item)
    {
        var technical = _consoleLogTechnicalDetails
            ? $" [{item.Source ?? "Activity"}] {item.EventType}"
                + (item.AttemptId is Guid attempt ? $" attempt={attempt:N}" : string.Empty)
                + (item.ErrorCode is null ? string.Empty : $" error={item.ErrorCode}")
            : string.Empty;
        return $"{item.Timestamp.ToLocalTime():yyyy-MM-dd HH:mm:ss} {FormatSeverity(item.Severity).ToUpperInvariant()} {FormatConsoleEvent(item)}{technical}";
    }

