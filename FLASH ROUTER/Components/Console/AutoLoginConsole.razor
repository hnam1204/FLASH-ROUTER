@namespace FLASH_ROUTER.Components.Console
@rendermode InteractiveServer
@using FLASH_ROUTER.Components.Console.Components
@using FlashAI.Foundation.Security
@using FlashAI.Modules.Accounts.Contracts
@using FlashAI.Modules.Connections.Application
@using FlashAI.Modules.Connections.Contracts
@using FlashAI.Modules.Connections.Domain
@using FlashAI.Modules.Diagnostics.Contracts
@using FlashAI.Modules.Activity.Contracts
@using Microsoft.JSInterop
@inject IAccountWorkspaceReader AccountReader
@inject IAccountCommandPort AccountCommand
@inject IPermanentAccountDeletionService PermanentAccountDeletion
@inject IBrowserProfileUiPort BrowserProfilePort
@inject IAccountBrowserSessionManager BrowserSessionManager
@inject ILiveProviderCertificationCoordinator LiveProviderCertification
@inject IAccountUsageReader AccountUsageReader
@inject IBrowserAuthOrchestrator BrowserAuthOrchestrator
@inject ICleanBrowserReloginService CleanBrowserRelogin
@inject IAccountCredentialUiPort CredentialPort
@inject IAccountConnectionsReader AccountConnectionsReader
@inject IProviderAccountObservationReader AccountObservationReader
@inject IAccountCopyUiPort AccountCopyPort
@inject IPlaywrightBrowserRuntime BrowserRuntime
@inject IConsoleProviderRegistry ProviderRegistry
@inject IActivityUiPort ActivityPort
@inject IActivityEventStream ActivityEventStream
@inject IDiagnosticsUiPort DiagnosticsPort
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>FLASH ROUTER | Quản lý tài khoản</PageTitle>

<div class="master-app-shell" data-theme-active="@_currentTheme">
    <!-- Single-page account workspace -->
    <div class="master-workspace">
        <AppTopbar SearchText="@_globalSearchText"
                   OnSearchChanged="HandleGlobalSearchChanged"
                   CurrentTheme="@_currentTheme"
                   OnToggleTheme="ToggleThemeAsync"
                   IsHealthy="@_isSystemHealthy"
                   StatusText="@_systemStatusText" />

        <div class="console-body-layout">
            <main class="main-console-content" role="main">
                <header class="console-page-header">
                    <div class="page-title-group">
                        <div class="title-with-badge">
                            <h1 class="page-title">Quản lý tài khoản</h1>
                            <span class="console-badge" title="FLASH ROUTER">Quản lý tập trung</span>
                        </div>
                        <p class="page-subtitle">
                            Quản lý tập trung tài khoản, phiên đăng nhập và thông tin sử dụng trên nhiều nền tảng.
                        </p>
                    </div>

                    <div class="page-header-actions">
                        <button type="button" class="page-primary-action" @onclick="OpenAddAccountDialog">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" aria-hidden="true">
                                <path d="M12 5v14M5 12h14"></path>
                            </svg>
                            <span>Thêm tài khoản</span>
                        </button>
                        <div class="page-header-meta">
                            <span class="system-time">Cập nhật lúc @_systemTimeString</span>
                            <div class="system-status-pill">
                                <span class="status-indicator-dot @(_isSystemHealthy ? "is-healthy" : "is-warning")"></span>
                                <span class="status-indicator-text">@_systemStatusText</span>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- 4 KPI Cards Section -->
                <KpiCardsSection TotalAccounts="@_totalAccountsCount"
                                 ActiveAccounts="@_activeAccountsCount"
                                 UnverifiedAccounts="@_unverifiedAccountsCount"
                                 FailedAccounts="@_failedAccountsCount" />

                <!-- Account Filter Toolbar -->
                <AccountFilterToolbar SelectedPlatform="@_platformFilter"
                                      OnPlatformChanged="HandlePlatformFilterChanged"
                                      SelectedStatus="@_statusFilter"
                                      OnStatusChanged="HandleStatusFilterChanged"
                                      TableSearchText="@_tableSearchText"
                                      OnTableSearchChanged="HandleTableSearchChanged"
                                      OnRefresh="RefreshDataAsync" />

                <!-- Accounts Table Section -->
                <AccountsTable Accounts="@_pagedAccounts"
                               SelectedAccountId="@_selectedAccountId"
                               CheckedAccountIds="@_checkedAccountIds"
                               OnAccountSelected="HandleAccountSelected"
                               OnAccountCheckToggled="HandleAccountCheckToggled"
                               OnSelectAllToggled="HandleSelectAllToggled"
                               OnOpenAccount="HandleOpenAccount"
                               OnLoginAgain="HandleLoginAgain"
                               OnEditAccount="HandleEditAccount"
                               OnToggleSort="HandleToggleSort"
                               CurrentPage="@_currentPage"
                               PageSize="@_pageSize"
                               TotalCount="@_filteredAccounts.Count"
                               OnPageChanged="HandlePageChanged"
                               OnPageSizeChanged="HandlePageSizeChanged" />
            </main>

            <!-- 3. RIGHT ACCOUNT INSPECTOR -->
            <AccountInspector Account="@_selectedAccountDetail"
                              ActivityEvents="@_selectedAccountActivities"
                              BrowserRuntime="@_selectedBrowserRuntime"
                              Usage="@_selectedUsage"
                              IsUsageRefreshRunning="@_isAutomationRunning"
                              UsageRefreshMessage="@_usageRefreshMessage"
                              Observation="@_selectedAccountObservation"
                              OnOpenAccount="HandleOpenAccountFromDetail"
                              OnLoginAgain="HandleLoginAgainFromDetail"
                              OnCloseBrowser="HandleCloseBrowserFromDetail"
                              OnEditAccount="HandleEditAccountFromDetail"
                              OnDeleteAccount="HandleDeleteAccountFromDetail"
                              OnSaveNotes="HandleSaveNotes"
                               OnCopyAccount="HandleCopyAccount"
                               OnOpenConsoleLog="OpenConsoleLog" />
        </div>
    </div>

    <!-- DIALOGS & MODALS -->
    <!-- Unified provider and credential entry -->
    <AddAccountDialog IsOpen="@_isAddAccountOpen"
                      OnClose="CloseAddAccountDialog"
                      OnSave="HandleCreateAccount" />

    <!-- Edit Account Dialog -->
    <EditAccountDialog IsOpen="@_isEditAccountOpen"
                       Account="@_selectedAccountDetail"
                       OnClose="CloseEditAccountDialog"
                       OnSave="HandleUpdateAccount" />

    <!-- Delete Confirmation Dialog -->
    <DeleteAccountDialog IsOpen="@_isDeleteAccountOpen"
                         Account="@_accountToDelete"
                         IsBusy="@_isPermanentDeleteRunning"
                         ErrorMessage="@_permanentDeleteError"
                         OnClose="CloseDeleteAccountDialog"
                         OnConfirmDelete="HandleConfirmDeleteAccount" />

    <!-- Browser Automation Execution Progress Dialog -->
    <AutomationProgressDialog IsOpen="@_isAutomationDialogOpen"
                              DialogTitle="@_automationDialogTitle"
                              StatusMessage="@_automationStatusMessage"
                              CurrentStage="@_automationStage"
                              TechnicalDetail="@_automationTechnicalDetail"
                              IsRunning="@_isAutomationRunning"
                              IsSuccess="@_isAutomationSuccess"
                              OnClose="CloseAutomationDialog"
                               OnHide="HideAutomationProgress"
                              OnCancel="CancelAutomation" />

    @if (_isCopyConfirmationOpen)
    {
        <div class="flash-overlay-backdrop" @onclick="CancelCopyAccount">
            <div class="flash-modal-card credential-copy-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="credential-copy-title">
                <div class="flash-modal-header">
                    <h3 id="credential-copy-title" class="flash-modal-title">Sao chép thông tin đăng nhập</h3>
                    <button type="button" class="flash-modal-close-btn" @onclick="CancelCopyAccount" aria-label="Đóng">✕</button>
                </div>
                <div class="flash-modal-body">
                    <p>Bạn sắp sao chép email, mật khẩu và thông tin 2FA của tài khoản này vào clipboard.</p>
                    <p class="credential-copy-format">Định dạng: <code>EMAIL | PASS | 2FA</code></p>
                    <p class="credential-copy-warning">Clipboard có thể được các ứng dụng khác đọc. Chỉ sao chép khi thực sự cần.</p>
                    @if (_copyFeedback is not null)
                    {
                        <div class="modal-error-banner" role="alert">@_copyFeedback</div>
                    }
                </div>
                <div class="flash-modal-footer">
                    <button type="button" class="flash-btn flash-btn-outline btn-modal-secondary" @onclick="CancelCopyAccount">Hủy</button>
                    <button type="button" class="flash-btn flash-btn-primary btn-modal-primary" @onclick="ConfirmCopyAccount">Sao chép tài khoản</button>
                </div>
            </div>
        </div>
    }

    @if (_isConsoleLogOpen)
    {
        <div class="flash-overlay-backdrop console-log-backdrop" @onclick="CloseConsoleLog">
            <section class="console-log-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="console-log-title">
                <header class="console-log-header">
                    <div>
                        <span class="inspector-eyebrow">LIVE AUTOMATION</span>
                        <h2 id="console-log-title">Nhật ký tự động hóa</h2>
                    <p>Theo dõi toàn bộ lịch sử account và quản lý trình duyệt · @(_selectedAccountDetail?.Email ?? "Tài khoản chưa chọn")</p>
                <div class="console-log-context" aria-label="Ngữ cảnh nhật ký tự động hóa">
                            <span>Provider: @FormatProviderName(_selectedAccountDetail?.Provider ?? "Chưa rõ")</span>
                            <span>Attempt: @FormatAttemptId(_selectedAccountDetail?.LastAuthenticationAttemptId)</span>
                            <span>Status: @FormatAuthenticationState(_selectedAccountDetail?.AuthenticationState)</span>
                            <span class="console-log-connection">@_consoleLogConnectionText</span>
                        </div>
                    </div>
                    <button type="button" class="flash-modal-close-btn" @onclick="CloseConsoleLog" aria-label="Đóng Console Log">✕</button>
                </header>
                <div class="console-log-toolbar">
                    <select @bind="_consoleLogSeverity" aria-label="Lọc nhật ký tự động hóa">
                        <option value="all">Tất cả</option>
                        <option value="Warning">Cảnh báo</option>
                        <option value="Error">Lỗi</option>
                    </select>
                    <input type="search" @bind="_consoleLogSearch" @bind:event="oninput" placeholder="Tìm trong nhật ký đã được làm sạch..." aria-label="Tìm nhật ký tự động hóa" />
                    <button type="button" class="@(_consoleLogAutoScroll ? "is-active" : "")" @onclick="ToggleConsoleLogAutoScroll">Tự cuộn: @(_consoleLogAutoScroll ? "Bật" : "Tắt")</button>
                    <button type="button" class="@(_consoleLogTechnicalDetails ? "is-active" : "")" @onclick="ToggleConsoleLogTechnicalDetails">Chi tiết kỹ thuật</button>
                    <button type="button" @onclick="ClearConsoleLogView">Xóa hiển thị</button>
                    <button type="button" @onclick="CopyConsoleLog">Sao chép nhật ký</button>
                    <button type="button" @onclick="ExportConsoleLog">Xuất nhật ký</button>
                </div>
                <div id="console-log-stream" class="console-log-stream" role="log" aria-live="polite">
                    @if (FilteredConsoleEvents.Count == 0)
                    {
                        <div class="console-log-empty">@GetConsoleLogEmptyMessage()</div>
                        @if (_selectedAccountActivities.Count > 0 && HasConsoleLogFilter)
                        {
                            <button type="button" class="console-log-clear-filter" @onclick="ClearConsoleLogFilters">Xóa bộ lọc</button>
                        }
                    }
                    else
                    {
                        var line = 0;
                        foreach (var ev in FilteredConsoleEvents)
                        {
                            line++;
                            <div class="console-log-line @(_consoleLogTechnicalDetails ? "has-technical-details" : "compact-message")">
                                <span class="console-log-index">@line.ToString("000")</span>
                                <span class="console-log-time">@ev.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                <span class="console-log-severity @FormatSeverity(ev.Severity).ToLowerInvariant()">@FormatSeverity(ev.Severity).ToUpperInvariant()</span>
                                @if (_consoleLogTechnicalDetails)
                                {
                                    <span class="console-log-source">[@(ev.Source ?? "Activity")]</span>
                                    <span class="console-log-message">@FormatConsoleEvent(ev)@(ev.DurationMs is long duration ? $" · {duration}ms" : string.Empty)</span>
                                }
                                else
                                {
                                    <span class="console-log-message">@FormatConsoleEvent(ev)@(ev.DurationMs is long duration ? $" · {duration}ms" : string.Empty)</span>
                                }
                            </div>
                        }
                    }
                </div>
            </section>
        </div>
    }

    <!-- Compatibility hooks retained for existing automation tests. -->
    <div class="developer-shell-support" style="display:none;" aria-hidden="true" data-purpose="automation-support">
        <button type="button" class="theme-toggle-btn" @onclick="ToggleThemeAsync">Theme Toggle</button>
        <span class="spec-format">EMAIL|PASS|2FA</span>
    </div>
</div>

@code {
    private string _currentTheme = "dark";
    private string _globalSearchText = "";
    private string _tableSearchText = "";
    private string _platformFilter = "all";
    private string _statusFilter = "all";
    private bool _sortAscending = false;

    private List<AccountListItemVm> _allAccounts = [];
    private List<AccountListItemVm> _filteredAccounts = [];
    private List<AccountListItemVm> _pagedAccounts = [];
    private readonly HashSet<Guid> _checkedAccountIds = [];

    private Guid? _selectedAccountId;
    private AccountDetailVm? _selectedAccountDetail;
    private List<ActivityEventVm> _selectedAccountActivities = [];
    private BrowserRuntimeSnapshot? _selectedBrowserRuntime;
    private AccountUsageView? _selectedUsage;
    private string? _usageRefreshMessage;
    private ProviderAccountObservationSnapshot? _selectedAccountObservation;

    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalAccountsCount = 0;
    private int _activeAccountsCount = 0;
    private int _unverifiedAccountsCount = 0;
    private int _failedAccountsCount = 0;

    private string _systemTimeString = DateTime.Now.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture);
    private string _systemStatusText = "Lưu trữ cục bộ sẵn sàng";
    private bool _isSystemHealthy = true;

    // Dialogs state
    private bool _isAddAccountOpen = false;
    private bool _isEditAccountOpen = false;
    private bool _isDeleteAccountOpen = false;
    private AccountDetailVm? _accountToDelete;
    private bool _isPermanentDeleteRunning;
    private string? _permanentDeleteError;

    // Automation progress dialog
    private bool _isAutomationDialogOpen = false;
    private string _automationDialogTitle = "Thực thi Browser Automation";
    private string _automationStatusMessage = "";
    private string _automationStage = "Khởi chạy";
    private string? _automationTechnicalDetail;
    private bool _isAutomationRunning = false;
    private bool _isAutomationSuccess = false;
    private CancellationTokenSource? _automationCts;
    private Guid? _activeAutomationAttemptId;
    private IDisposable? _activitySubscription;
    private Guid? _copyConfirmationAccountId;
    private bool _isCopyConfirmationOpen;
    private string? _copyFeedback;
    private bool _isConsoleLogOpen;
    private string _consoleLogSeverity = "all";
    private string _consoleLogSearch = string.Empty;
    private bool _consoleLogAutoScroll = true;
    private bool _consoleLogTechnicalDetails;
    private string _consoleLogConnectionText = "Live · đã kết nối";
    private readonly List<ActivityEventVm> _clearedConsoleEvents = [];

    private IReadOnlyList<ActivityEventVm> FilteredConsoleEvents
        => _selectedAccountActivities
            .Where(item => !_clearedConsoleEvents.Contains(item))
            .Where(item => _consoleLogSeverity.Equals("all", StringComparison.OrdinalIgnoreCase)
                || FormatSeverity(item.Severity).Equals(FormatSeverity(_consoleLogSeverity), StringComparison.OrdinalIgnoreCase))
            .Where(item => string.IsNullOrWhiteSpace(_consoleLogSearch)
                || FormatConsoleEvent(item).Contains(_consoleLogSearch, StringComparison.OrdinalIgnoreCase)
                || (_consoleLogTechnicalDetails && item.EventType.Contains(_consoleLogSearch, StringComparison.OrdinalIgnoreCase))
                || (_consoleLogTechnicalDetails && (item.SafeDetails?.Contains(_consoleLogSearch, StringComparison.OrdinalIgnoreCase) ?? false)))
            .OrderBy(item => item.Timestamp)
            .ThenBy(item => item.EventId)
            .Take(200)
            .ToArray();

    private bool HasConsoleLogFilter
        => !_consoleLogSeverity.Equals("all", StringComparison.OrdinalIgnoreCase)
            || !string.IsNullOrWhiteSpace(_consoleLogSearch);

    protected override async Task OnInitializedAsync()
    {
        _activitySubscription = ActivityEventStream.Subscribe(HandleLiveActivityAsync);
        await LoadThemeAsync();
        await LoadDiagnosticsAsync();
        await RefreshDataAsync();
    }

    private async Task LoadThemeAsync()
    {
        try
        {
            var stored = await JSRuntime.InvokeAsync<string>("flashRouter.getTheme");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _currentTheme = stored;
            }
        }
        catch
        {
            _currentTheme = "dark";
        }
    }

    public async Task ToggleThemeAsync()
    {
        try
        {
            _currentTheme = await JSRuntime.InvokeAsync<string>("flashRouter.toggleTheme");
        }
        catch
        {
            _currentTheme = _currentTheme == "dark" ? "light" : "dark";
        }
        StateHasChanged();
    }

    private async Task LoadDiagnosticsAsync()
    {
        try
        {
            var diag = await DiagnosticsPort.GetDiagnosticsAsync();
            _isSystemHealthy = diag.DurableStorageStatus.Contains("Ready", StringComparison.OrdinalIgnoreCase)
                               || diag.DurableStorageStatus.Contains("Connected", StringComparison.OrdinalIgnoreCase)
                               || diag.DurableStorageStatus.Contains("Healthy", StringComparison.OrdinalIgnoreCase)
                               || diag.Mode.Contains("Integrated", StringComparison.OrdinalIgnoreCase)
                               || diag.Mode.Contains("Preview", StringComparison.OrdinalIgnoreCase);

            _systemStatusText = _isSystemHealthy
                ? "Lưu trữ cục bộ sẵn sàng"
                : "Đang kiểm tra lưu trữ";
        }
        catch
        {
            _isSystemHealthy = true;
            _systemStatusText = "Lưu trữ cục bộ sẵn sàng";
        }
    }

    private async Task RefreshDataAsync()
    {
        _systemTimeString = DateTime.Now.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture);

        try
        {
            var accounts = await AccountReader.GetAccountsAsync();
            _allAccounts = accounts.ToList();
        }
        catch
        {
            _allAccounts = [];
        }

        // Calculate KPIs from actual real loaded accounts
        _totalAccountsCount = _allAccounts.Count;
        _activeAccountsCount = _allAccounts.Count(a => a.AuthenticationState.Equals("AuthenticatedSessionConfirmed", StringComparison.OrdinalIgnoreCase));
        // Identity verification is independent from browser-session confirmation;
        // accounts without verified provider evidence remain actionable.
        _unverifiedAccountsCount = _allAccounts.Count(a =>
            !a.IdentityVerificationState.Equals("IdentityVerified", StringComparison.OrdinalIgnoreCase));
        _failedAccountsCount = _allAccounts.Count(a => a.Status.Equals("ConnectionError", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase));

        ApplyFiltersAndPagination();

        // Select first account if none selected
        if (_selectedAccountId is null && _filteredAccounts.Count > 0)
        {
            await HandleAccountSelected(_filteredAccounts[0].AccountId);
        }
        else if (_selectedAccountId != null)
        {
            await LoadAccountDetailAsync(_selectedAccountId.Value);
        }
    }

    private void ApplyFiltersAndPagination()
    {
        IEnumerable<AccountListItemVm> query = _allAccounts;

        // Global search & Table search combined
        var searchTerm = !string.IsNullOrWhiteSpace(_globalSearchText) ? _globalSearchText.Trim() : _tableSearchText.Trim();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(a =>
                a.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                a.DisplayName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                a.Provider.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                a.RecordedPlan.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                a.Tags.Any(t => t.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
        }

        // Platform filter
        if (_platformFilter != "all")
        {
            query = query.Where(a => a.Provider.Contains(_platformFilter, StringComparison.OrdinalIgnoreCase));
        }

        // Status filter
        if (_statusFilter != "all")
        {
            query = _statusFilter switch
            {
                "connected" => query.Where(a => a.Status.Equals("Connected", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Active", StringComparison.OrdinalIgnoreCase)),
                "unverified" => query.Where(a => a.Status.Equals("Unverified", StringComparison.OrdinalIgnoreCase)),
                "expired" => query.Where(a => a.Status.Equals("ReauthNeeded", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Expired", StringComparison.OrdinalIgnoreCase)),
                "failed" => query.Where(a => a.Status.Equals("ConnectionError", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase)),
                _ => query
            };
        }

        // Sorting
        query = _sortAscending
            ? query.OrderBy(a => a.TrackingDate)
            : query.OrderByDescending(a => a.TrackingDate);

        _filteredAccounts = query.ToList();

        // Pagination
        var skip = (_currentPage - 1) * _pageSize;
        _pagedAccounts = _filteredAccounts.Skip(skip).Take(_pageSize).ToList();
    }

    private async Task HandleAccountSelected(Guid accountId)
    {
        if (_selectedAccountId != accountId)
        {
            _selectedAccountDetail = null;
            _selectedAccountActivities = [];
            _selectedBrowserRuntime = null;
            _selectedUsage = null;
            _usageRefreshMessage = null;
            _selectedAccountObservation = null;
        }

        _selectedAccountId = accountId;
        await LoadAccountDetailAsync(accountId);
    }

    private async Task LoadAccountDetailAsync(Guid accountId)
    {
        AccountDetailVm? detail = null;
        try
        {
            detail = await AccountReader.GetAccountDetailAsync(accountId);
        }
        catch
        {
            detail = null;
        }

        try
        {
            var connections = await AccountConnectionsReader.ListForAccountAsync(accountId);
            var credentialReferencePresent = connections.Any(connection =>
                connection.ProviderId.Equals("openai-chatgpt", StringComparison.OrdinalIgnoreCase)
                && connection.ConnectionKind == ConnectionKind.Manual
                && connection.CredentialAvailability == ConnectionCredentialAvailability.StoredReference);
            _selectedAccountDetail = detail is null
                ? null
                : detail with { CredentialReferencePresent = credentialReferencePresent };
        }
        catch
        {
            _selectedAccountDetail = detail;
        }

        try
        {
            var events = await ActivityPort.GetEventsAsync(accountId);
            _selectedAccountActivities = events
                .GroupBy(item => item.EventId)
                .Select(group => group.First())
                .ToList();
        }
        catch
        {
            // Keep the last historical journal visible when another projection fails.
        }

        try
        {
            _selectedBrowserRuntime = await BrowserSessionManager.GetStatusAsync(accountId);
        }
        catch
        {
            _selectedBrowserRuntime = null;
        }

        try
        {
            _selectedUsage = await AccountUsageReader.GetAsync(accountId);
        }
        catch
        {
            _selectedUsage = null;
        }

        try
        {
            _selectedAccountObservation = await AccountObservationReader.GetLatestAsync(accountId);
        }
        catch
        {
            _selectedAccountObservation = null;
        }
    }

    private void HandleAccountCheckToggled((Guid Id, bool Checked) args)
    {
        if (args.Checked)
        {
            _checkedAccountIds.Add(args.Id);
        }
        else
        {
            _checkedAccountIds.Remove(args.Id);
        }
    }

    private void HandleSelectAllToggled(bool isChecked)
    {
        if (isChecked)
        {
            foreach (var account in _pagedAccounts)
            {
                _checkedAccountIds.Add(account.AccountId);
            }
        }
        else
        {
            _checkedAccountIds.Clear();
        }
    }

    private void HandleGlobalSearchChanged(string text)
    {
        _globalSearchText = text;
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    private void HandleTableSearchChanged(string text)
    {
        _tableSearchText = text;
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    private void HandlePlatformFilterChanged(string platform)
    {
        _platformFilter = platform;
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    private void HandleStatusFilterChanged(string status)
    {
        _statusFilter = status;
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    private void HandleToggleSort()
    {
        _sortAscending = !_sortAscending;
        ApplyFiltersAndPagination();
    }

    private void HandlePageChanged(int page)
    {
        _currentPage = page;
        ApplyFiltersAndPagination();
    }

    private void HandlePageSizeChanged(int size)
    {
        _pageSize = size;
        _currentPage = 1;
        ApplyFiltersAndPagination();
    }

    // Modal Operations
    private void OpenAddAccountDialog() => _isAddAccountOpen = true;
    private void CloseAddAccountDialog() => _isAddAccountOpen = false;

    private void CloseEditAccountDialog() => _isEditAccountOpen = false;

    private void CloseDeleteAccountDialog()
    {
        if (_isPermanentDeleteRunning) return;
        _isDeleteAccountOpen = false;
        _accountToDelete = null;
        _permanentDeleteError = null;
    }

    private void CloseAutomationDialog() => _isAutomationDialogOpen = false;

    private void HideAutomationProgress() => _isAutomationDialogOpen = false;

    private async Task HandleCreateAccount(CreateAccountRequest request)
    {
        _isAddAccountOpen = false;
        try
        {
            if (!CredentialLineCodec.TryParse(request.CredentialLine, out var credential, out var parseError) || credential is null)
            {
                ShowAutomationFailure("Credential không hợp lệ", parseError);
                return;
            }

            var createResult = await AccountCommand.CreateAccountAsync(request.Profile);
            if (!createResult.IsSuccess)
            {
                ShowAutomationFailure("Không thể lưu tài khoản", createResult.Message ?? "Dữ liệu tài khoản chưa hợp lệ.");
                return;
            }

            var account = (await AccountReader.GetAccountsAsync(request.Profile.Email))
                .FirstOrDefault(item => item.Provider.Equals(request.Profile.Provider, StringComparison.OrdinalIgnoreCase));
            if (account is null)
            {
                ShowAutomationFailure("Không thể xác định tài khoản", "Tài khoản đã lưu nhưng không tìm thấy bản ghi để gắn credential.");
                return;
            }

            var credentialResult = await CredentialPort.SaveAsync(
                account.AccountId,
                new ChatGptCredentialInput(credential.Account, credential.Password, credential.TotpSeed, true));
            if (!credentialResult.IsSuccess)
            {
                ShowAutomationFailure("Không thể lưu credential", credentialResult.Message);
                await RefreshDataAsync();
                return;
            }

            await RefreshDataAsync();
            await ExecuteLoginAgain(account.AccountId, account.Email);
        }
        catch (Exception ex)
        {
            ShowAutomationFailure("Không thể hoàn tất đăng ký", ex.Message);
        }
        finally
        {
            request.ClearSensitive();
        }
    }

