    private async Task ExecuteBrowserLaunch(Guid accountId, string email)
    {
        _automationCts?.Cancel();
        _automationCts = new CancellationTokenSource();

        _automationDialogTitle = "Mở trình duyệt cô lập";
        _automationStage = "Khởi chạy";
        _automationStatusMessage = $"Đang chuẩn bị hồ sơ Chromium cô lập cho {email}...";
        _automationTechnicalDetail = "Kiểm tra quyền sở hữu Chromium và tài nguyên hồ sơ...";
        _isAutomationRunning = true;
        _isAutomationSuccess = false;
        _isAutomationDialogOpen = true;
        StateHasChanged();

        try
        {
            var launchResult = await BrowserSessionManager.OpenAsync(accountId, _automationCts.Token);

            if (launchResult.IsSuccess)
            {
                _automationStage = "Hoàn tất";
                _automationStatusMessage = $"Đã mở cửa sổ trình duyệt Chromium thành công cho tài khoản {email}.";
                _automationTechnicalDetail = $"Runtime: {launchResult.Snapshot.RuntimeState}; profile ownership is account-scoped.";
                _isAutomationRunning = false;
                _isAutomationSuccess = true;
                await RefreshDataAsync();
            }
            else
            {
                _automationStage = "Không thể mở";
                _automationStatusMessage = launchResult.Message;
                _automationTechnicalDetail = $"Trạng thái mã lỗi: {launchResult.Status}";
                _isAutomationRunning = false;
                _isAutomationSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _automationStage = "Lỗi ngoại lệ";
            _automationStatusMessage = "Đã xảy ra lỗi khi khởi chạy Microsoft.Playwright Chromium.";
            _automationTechnicalDetail = ex.Message;
            _isAutomationRunning = false;
            _isAutomationSuccess = false;
        }

        StateHasChanged();
    }

    private Task HandleCloseBrowserFromDetail(AccountDetailVm account)
        => ExecuteBrowserOperationAsync(account.AccountId, "Đóng trình duyệt", BrowserSessionManager.CloseAsync);

    private async Task ExecuteBrowserOperationAsync(
        Guid accountId,
        string operation,
        Func<Guid, CancellationToken, Task<BrowserOperationResult>> action)
    {
        _automationDialogTitle = operation;
        _automationStage = "Đang xử lý";
        _automationStatusMessage = operation + " cho account đang chọn...";
        _automationTechnicalDetail = "Account-scoped browser lifecycle";
        _isAutomationRunning = true;
        _isAutomationSuccess = false;
        _isAutomationDialogOpen = true;
        StateHasChanged();
        try
        {
            var result = await action(accountId, CancellationToken.None);
            _automationStage = result.IsSuccess ? "Hoàn tất" : "Chưa hoàn tất";
            _automationStatusMessage = result.Message;
            _automationTechnicalDetail = result.Status;
            _isAutomationSuccess = result.IsSuccess;
            _selectedBrowserRuntime = result.Snapshot;
            await RefreshDataAsync();
        }
        catch
        {
            _automationStage = "Lỗi thao tác";
            _automationStatusMessage = "Không thể hoàn tất thao tác browser của account này.";
            _automationTechnicalDetail = "BROWSER_OPERATION_FAILED";
        }
        finally
        {
            _isAutomationRunning = false;
            StateHasChanged();
        }
    }

