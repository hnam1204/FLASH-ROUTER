@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment WebHostEnvironment

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (function() {
            try {
                var theme = localStorage.getItem('flashrouter_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', theme);
            } catch(e) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <link rel="stylesheet" href="foundation/tokens.css" />
    <link rel="stylesheet" href="foundation/reset.css" />
    <link rel="stylesheet" href="foundation/typography.css" />
    <link rel="stylesheet" href="foundation/shell.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="FLASH_ROUTER.styles.css" />
    @foreach (var moduleName in ModuleNames)
    {
        <link rel="stylesheet" href="@ResolveModuleStylesheet(moduleName)" />
    }
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="app.js"></script>
</body>

</html>

@code {
    private static readonly string[] ModuleNames =
    [
        "FlashAI.Modules.Dashboard",
        "FlashAI.Modules.Connections",
        "FlashAI.Modules.Subscriptions",
        "FlashAI.Modules.Authenticator",
        "FlashAI.Modules.ImportExport",
        "FlashAI.Modules.Reminders",
        "FlashAI.Modules.BackupRestore",
        "FlashAI.Modules.Activity",
        "FlashAI.Modules.Settings",
        "FlashAI.Modules.Diagnostics"
    ];

    private string ResolveModuleStylesheet(string moduleName)
    {
        var directory = WebHostEnvironment.WebRootFileProvider.GetDirectoryContents($"_content/{moduleName}");
        var stylesheet = directory.FirstOrDefault(file =>
            !file.IsDirectory
            && file.Name.StartsWith(moduleName + ".", StringComparison.Ordinal)
            && file.Name.EndsWith(".bundle.scp.css", StringComparison.OrdinalIgnoreCase));

        return stylesheet is null
            ? $"_content/{moduleName}/{moduleName}.bundle.scp.css"
            : $"_content/{moduleName}/{stylesheet.Name}";
    }
}
