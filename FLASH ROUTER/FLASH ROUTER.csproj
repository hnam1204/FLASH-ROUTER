<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FLASH ROUTER</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\FlashAI.Foundation\FlashAI.Foundation.csproj" />
    <ProjectReference Include="..\src\Modules\Accounts\FlashAI.Modules.Accounts.csproj" />
    <ProjectReference Include="..\src\Modules\Connections\FlashAI.Modules.Connections.csproj" />
    <ProjectReference Include="..\src\Modules\Operations\FlashAI.Modules.Operations.csproj" />
    <ProjectReference Include="..\src\Modules\Workspace\FlashAI.Modules.Workspace.csproj" />
  </ItemGroup>

</Project>
