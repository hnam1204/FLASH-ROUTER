@using FlashAI.Modules.Authenticator.Contracts
@inject IAuthenticatorUiPort AuthPort
@implements IDisposable

<div class="auth-tab-container">
    @if (_isLocked)
    {
        <div class="vault-locked-card">
            <div class="lock-icon-circle">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </div>
            <h3>Két bảo mật 2FA đang khóa</h3>
            <p>Nhập passphrase để mở khóa và xem mã xác thực hai lớp (TOTP).</p>
            <div class="unlock-form">
                <input type="password"
                       class="unlock-input"
                       placeholder="Nhập mật khẩu mở khóa..."
                       @bind="_passphrase"
                       @onkeydown="HandleUnlockKeyDown" />
                <button type="button" class="btn-unlock" @onclick="UnlockVault">
                    Mở khóa
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_lockError))
            {
                <span class="lock-error-text">@_lockError</span>
            }
        </div>
    }
    else
    {
        <div class="vault-unlocked-container">
            <div class="vault-header-bar">
                <div class="vault-status-indicator">
                    <span class="status-shield">🛡️</span>
                    <div>
                        <h4 class="vault-title">Két bảo mật 2FA</h4>
                        @if (_credentials.Any(credential => credential.IsDemo))
                        {
                            <span class="demo-notice-tag">DEMO DATA — MÃ TỔNG HỢP KIỂM THỬ</span>
                        }
                    </div>
                </div>

                <div class="vault-actions">
                    <button type="button" class="btn-add-cred" @onclick="ToggleAddModal">
                        + Thêm khóa TOTP
                    </button>
                    <button type="button" class="btn-lock-vault" title="Khóa két bảo mật" @onclick="LockVault">
                        🔒 Khóa két
                    </button>
                </div>
            </div>

            @if (_credentials.Count == 0)
            {
                <div class="totp-empty-state">
                        <p>Chưa có cấu hình TOTP nào cho tài khoản này.</p>
                    <button type="button" class="btn-add-first-cred" @onclick="ToggleAddModal">
                        Thêm khóa TOTP
                    </button>
                </div>
            }
            else
            {
                <div class="totp-card-list">
                    @foreach (var cred in _credentials)
                    {
                        <div class="totp-card" @key="cred.CredentialId">
                            <div class="totp-card-header">
                                <div>
                                    <span class="totp-issuer">@cred.Issuer</span>
                                    <span class="totp-label">@cred.AccountLabel</span>
                                </div>
                                <span class="totp-masked-secret" title="Khóa bí mật đã được mã hóa an toàn">
                                    @cred.MaskedSecret
                                </span>
                            </div>

                            <div class="totp-display-row">
                                <div class="totp-code-box">
                                    <span class="totp-code">@FormatCode(_currentCode?.Code ?? "------")</span>
                                </div>

                                <div class="totp-timer-box">
                                    <svg class="countdown-svg" viewBox="0 0 36 36">
                                        <path class="circle-bg"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                        <path class="circle-progress"
                                              stroke-dasharray="@((_remainingSeconds * 100 / 30) + ", 100")"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                        <text x="18" y="21" class="timer-text">@_remainingSeconds</text>
                                    </svg>
                                </div>

                                <button type="button"
                                        class="btn-copy-totp"
                                        title="Sao chép mã 6 số"
                                        @onclick="CopyCurrentCode">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                    </svg>
                                    <span>Sao chép</span>
                                </button>

                                <button type="button"
                                        class="btn-remove-totp"
                                        title="Xóa khóa này"
                                        @onclick="() => RemoveCredential(cred.CredentialId)">
                                    ✕
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (_showAddModal)
            {
                <div class="totp-inline-dialog">
                    <h4 class="dialog-title">Thêm khóa TOTP</h4>
                    <div class="dialog-form">
                        <div class="dialog-field">
                            <label>Dịch vụ / Nhà cung cấp</label>
                            <input type="text" class="dialog-input" placeholder="Ví dụ: OpenAI / ChatGPT" @bind="_newIssuer" />
                        </div>
                        <div class="dialog-field">
                            <label>Tên nhãn tài khoản</label>
                            <input type="text" class="dialog-input" placeholder="Ví dụ: account01@example.com" @bind="_newLabel" />
                        </div>
                        <div class="dialog-field">
                            <label>Khóa bí mật TOTP</label>
                            <input type="text" class="dialog-input" placeholder="JBSWY3DPEHPK3PXP" @bind="_newSeed" />
                        </div>
                    </div>
                    <div class="dialog-actions">
                        <button type="button" class="btn-dialog-cancel" @onclick="ToggleAddModal">Hủy</button>
                        <button type="button" class="btn-dialog-submit" @onclick="AddCredential">Lưu khóa đã mã hóa</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid AccountId { get; set; }
    [Parameter] public EventCallback<string> OnNotify { get; set; }
    [Parameter] public EventCallback<string> OnCopyRequested { get; set; }

    private bool _isLocked = false;
    private string _passphrase = string.Empty;
    private string? _lockError;

    private List<TotpCredentialVm> _credentials = [];
    private TotpCodeVm? _currentCode;
    private int _remainingSeconds = 30;
    private Timer? _countdownTimer;

    private bool _showAddModal = false;
    private string _newIssuer = "OpenAI (DEMO)";
    private string _newLabel = string.Empty;
    private string _newSeed = "JBSWY3DPEHPK3PXP";

    protected override async Task OnParametersSetAsync()
    {
        _isLocked = await AuthPort.IsVaultLockedAsync();
        if (!_isLocked)
        {
            await LoadCredentials();
        }
    }

    protected override void OnInitialized()
    {
        _countdownTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                if (!_isLocked && _credentials.Count > 0)
                {
                    _currentCode = await AuthPort.GetCurrentCodeAsync(_credentials[0].CredentialId);
                    if (_currentCode != null)
                    {
                        _remainingSeconds = _currentCode.RemainingSeconds;
                    }
                    StateHasChanged();
                }
            });
        }, null, 1000, 1000);
    }

    private async Task LoadCredentials()
    {
        _credentials = (await AuthPort.GetCredentialsAsync(AccountId)).ToList();
        if (_credentials.Count > 0)
        {
            _currentCode = await AuthPort.GetCurrentCodeAsync(_credentials[0].CredentialId);
            if (_currentCode != null)
            {
                _remainingSeconds = _currentCode.RemainingSeconds;
            }
        }
    }

    private async Task UnlockVault()
    {
        _lockError = null;
        var res = await AuthPort.UnlockVaultAsync(_passphrase);
        if (res.IsSuccess)
        {
            _isLocked = false;
            _passphrase = string.Empty;
            await LoadCredentials();
            await OnNotify.InvokeAsync("Đã mở khóa két bảo mật thành công.");
        }
        else
        {
            _lockError = res.Message;
        }
    }

    private async Task HandleUnlockKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await UnlockVault();
        }
    }

    private async Task LockVault()
    {
        await AuthPort.LockVaultAsync();
        _isLocked = true;
        _currentCode = null;
        await OnNotify.InvokeAsync("Đã khóa két bảo mật.");
    }

    private void ToggleAddModal()
    {
        _showAddModal = !_showAddModal;
    }

    private async Task AddCredential()
    {
        if (string.IsNullOrWhiteSpace(_newLabel))
        {
            _newLabel = "account01@example.com";
        }

        var res = await AuthPort.AddCredentialAsync(AccountId, _newIssuer, _newLabel, _newSeed);
        if (res.IsSuccess)
        {
            _showAddModal = false;
            await LoadCredentials();
            await OnNotify.InvokeAsync("Đã thêm khóa TOTP vào két bảo mật.");
        }
    }

    private async Task RemoveCredential(Guid credentialId)
    {
        var res = await AuthPort.RemoveCredentialAsync(credentialId);
        if (res.IsSuccess)
        {
            await LoadCredentials();
            await OnNotify.InvokeAsync("Đã xóa khóa 2FA.");
        }
    }

    private async Task CopyCurrentCode()
    {
        if (_currentCode != null)
        {
            await OnCopyRequested.InvokeAsync(_currentCode.Code);
            await OnNotify.InvokeAsync("Đã sao chép mã TOTP hiện tại.");
        }
    }

    private static string FormatCode(string code)
    {
        if (code.Length == 6)
        {
            return code[..3] + " " + code[3..];
        }
        return code;
    }

    public void Dispose()
    {
        _countdownTimer?.Dispose();
    }
}
