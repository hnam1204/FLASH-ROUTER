@page "/subscriptions"

<PageTitle>Subscriptions | FLASH ROUTER</PageTitle>

<section class="subscriptions-page" aria-labelledby="subscriptions-title">
    <div class="subscriptions-intro">
        <p class="subscriptions-eyebrow">OBSERVATIONS</p>
        <h1 id="subscriptions-title">Subscriptions</h1>
        <p class="subscriptions-description">Record plan observations with source, timestamp, confidence, and expiry context. Unverified values stay visibly unverified.</p>
    </div>

    <div class="subscriptions-status" role="status">
        <span class="subscriptions-status-mark" aria-hidden="true"></span>
        <div>
            <p class="subscriptions-status-label">Phase 0A status</p>
            <h2>No observations available</h2>
            <p>The scaffold never claims Plus, Pro, quota, billing, or reset status without an allowed source.</p>
        </div>
    </div>

    <a class="subscriptions-action" href="/settings">Open Settings<span aria-hidden="true"> -></span></a>
</section>

