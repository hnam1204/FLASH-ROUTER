@page "/activity"

<PageTitle>Activity | FLASH ROUTER</PageTitle>

<section class="activity-page" aria-labelledby="activity-title">
    <div class="activity-intro">
        <p class="activity-eyebrow">SAFE AUDIT TRAIL</p>
        <h1 id="activity-title">Activity</h1>
        <p class="activity-description">A redacted activity surface for safe summaries, correlation IDs, and operational events.</p>
    </div>

    <div class="activity-status" role="status">
        <span class="activity-status-mark" aria-hidden="true"></span>
        <div>
            <p class="activity-status-label">Phase 0A status</p>
            <h2>No activity events yet</h2>
            <p>Sensitive credentials and callback contents are never intended for this surface.</p>
        </div>
    </div>

    <a class="activity-action" href="/diagnostics">Open Diagnostics<span aria-hidden="true"> -></span></a>
</section>

