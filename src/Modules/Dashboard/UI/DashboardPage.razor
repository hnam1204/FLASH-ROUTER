@page "/dashboard"

<PageTitle>Dashboard | FLASH ROUTER</PageTitle>

<section class="dashboard-page" aria-labelledby="dashboard-title">
    <div class="dashboard-intro">
        <p class="dashboard-eyebrow">LOCAL CONTROL PLANE</p>
        <h1 id="dashboard-title">Dashboard</h1>
        <p class="dashboard-description">A quiet overview of your local workspace. Live account, connection, and subscription data will appear here after their owning modules are implemented.</p>
    </div>

    <div class="dashboard-status" role="status">
        <span class="dashboard-status-mark" aria-hidden="true"></span>
        <div>
            <p class="dashboard-status-label">Phase 0A status</p>
            <h2>No account records yet</h2>
            <p>The dashboard is intentionally empty until real records exist. No fabricated health, plan, or quota values are shown.</p>
        </div>
    </div>

    <a class="dashboard-action" href="/accounts">Open Accounts<span aria-hidden="true"> -></span></a>
</section>

