@page "/import-export"

<PageTitle>Import / Export | FLASH ROUTER</PageTitle>

<section class="importexport-page" aria-labelledby="importexport-title">
    <div class="importexport-intro">
        <p class="importexport-eyebrow">SAFE DATA EXCHANGE</p>
        <h1 id="importexport-title">Import / Export</h1>
        <p class="importexport-description">Preview-first metadata import and export with duplicate handling and spreadsheet formula safeguards planned for Phase 3.</p>
    </div>

    <div class="importexport-status" role="status">
        <span class="importexport-status-mark" aria-hidden="true"></span>
        <div>
            <p class="importexport-status-label">Phase 0A status</p>
            <h2>Import pipeline is not enabled</h2>
            <p>Passwords, tokens, and authenticator seeds are outside ordinary metadata export.</p>
        </div>
    </div>

    <a class="importexport-action" href="/accounts">Open Accounts<span aria-hidden="true"> -></span></a>
</section>

