@using FlashAI.Modules.BackupRestore.Contracts
@inject IBackupRestoreUiPort BackupPort

<div class="flash-overlay-backdrop" @onclick="HandleClose">
    <div class="flash-modal-card backup-modal-card" @onclick:stopPropagation="true">
        <div class="flash-modal-header">
            <h3 class="flash-modal-title">Sao lưu & Khôi phục dữ liệu</h3>
            <button type="button" class="flash-modal-close-btn" @onclick="HandleClose">✕</button>
        </div>

        <div class="flash-modal-body">
            <p class="backup-desc">Quản lý các điểm phục hồi dữ liệu cấu hình cục bộ của FLASH ROUTER.</p>

            <div class="create-backup-box">
                <div class="create-inputs">
                    <input type="text"
                           class="backup-name-input"
                           placeholder="Tên bản sao lưu..."
                           @bind="_newBackupName" />
                    <select class="backup-type-select" @bind="_newBackupType">
                        <option value="Toàn phần">Toàn phần</option>
                    </select>
                </div>
                <button type="button" class="btn-create-backup" @onclick="CreateBackup">
                    Tạo bản sao lưu
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_noticeMessage))
            {
                <div class="backup-notice @(_isNoticeError ? "notice-error" : "notice-info")">
                    @_noticeMessage
                </div>
            }

            <div class="backups-list-section">
                <h4 class="backups-heading">Các bản sao lưu hiện có</h4>
                @if (_loading)
                {
                    <div class="loading-text">Đang tải danh sách sao lưu...</div>
                }
                else if (_backups.Count == 0)
                {
                    <div class="empty-text">Chưa có bản sao lưu nào.</div>
                }
                else
                {
                    <div class="backups-stack">
                        @foreach (var b in _backups)
                        {
                            <div class="backup-row" @key="b.BackupId">
                                <div class="backup-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <ellipse cx="12" cy="5" rx="9" ry="3" />
                                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                                    </svg>
                                </div>
                                <div class="backup-meta">
                                    <span class="backup-filename">@b.Name</span>
                                    <span class="backup-sub">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm") • @b.SizeDisplay • @b.Type</span>
                                </div>
                                <div class="backup-actions">
                                    <button type="button" class="btn-restore" @onclick="() => RequestRestore(b.BackupId)">
                                        Kiểm tra khôi phục
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (_pendingRestoreId is not null)
        {
            <div class="backup-confirmation" role="alert">
                <span>Thao tác chỉ giải mã vào thư mục tạm, kiểm tra integrity rồi tự xóa; không ghi đè database đang dùng.</span>
                <button type="button" class="btn-confirm-restore" @onclick="ConfirmRestore">Xác nhận kiểm tra</button>
            </div>
        }

        <div class="flash-modal-footer">
            <button type="button" class="btn-dialog-ghost" @onclick="HandleClose">Đóng</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback<string> OnNotify { get; set; }

    private List<BackupItemVm> _backups = [];
    private bool _loading = true;
    private string _newBackupName = $"flash-backup-{DateTime.Now:yyyyMMdd-HHmm}.bak";
    private string _newBackupType = "Toàn phần";
    private string? _noticeMessage;
    private bool _isNoticeError;
    private Guid? _pendingRestoreId;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _backups = (await BackupPort.GetBackupsAsync()).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateBackup()
    {
        var res = await BackupPort.RequestCreateBackupAsync(_newBackupName, _newBackupType);
        _noticeMessage = res.Message;
        _isNoticeError = !res.IsSuccess;
        await OnNotify.InvokeAsync(res.Message);
    }

    private async Task RequestRestore(Guid backupId)
    {
        var res = await BackupPort.RequestRestoreAsync(backupId);
        if (res.ErrorCode == "RESTORE_CONFIRMATION_REQUIRED")
        {
            _pendingRestoreId = backupId;
        }

        _noticeMessage = res.Message;
        _isNoticeError = !res.IsSuccess;
        await OnNotify.InvokeAsync(res.Message);
    }

    private async Task ConfirmRestore()
    {
        if (_pendingRestoreId is not Guid backupId)
        {
            return;
        }

        var res = await BackupPort.RequestRestoreAsync(backupId, confirmed: true);
        _pendingRestoreId = null;
        _noticeMessage = res.Message;
        _isNoticeError = !res.IsSuccess;
        await OnNotify.InvokeAsync(res.Message);
    }

    private async Task HandleClose() => await OnClosed.InvokeAsync();
}
