@page "/settings"

<PageTitle>Settings | FLASH ROUTER</PageTitle>

<section class="settings-page" aria-labelledby="settings-title">
    <div class="settings-intro">
        <p class="settings-eyebrow">LOCAL PREFERENCES</p>
        <h1 id="settings-title">Settings</h1>
        <p class="settings-description">A future home for theme, privacy, local security, vault, and background preferences. Business logic stays in its owning module.</p>
    </div>

    <div class="settings-status" role="status">
        <span class="settings-status-mark" aria-hidden="true"></span>
        <div>
            <p class="settings-status-label">Phase 0A status</p>
            <h2>Preferences are not persisted</h2>
            <p>The settings route does not act as a universal service or credential store.</p>
        </div>
    </div>

    <a class="settings-action" href="/diagnostics">Read Diagnostics<span aria-hidden="true"> -></span></a>
</section>

